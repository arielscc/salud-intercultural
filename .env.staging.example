# Copy only to a secure local file when operating staging.
# In Vercel, configure these values for Preview deployments from branch staging.

APP_ENV="staging"
NEXT_PUBLIC_APP_ENV="staging"

NEXT_PUBLIC_SITE_URL="https://staging.saludintercultural.com"
NEXT_PUBLIC_SITE_NAME="Salud Intercultural · STAGING"

# Staging never sends analytics events to production properties.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
GOOGLE_SITE_VERIFICATION=""

# Synthetic contact values. The UI also blocks WhatsApp, calls, SMS and email.
NEXT_PUBLIC_WHATSAPP_NUMBER="+59100000000"
NEXT_PUBLIC_CALL_PHONE="+59100000000"
NEXT_PUBLIC_CONTACT_EMAIL="qa@staging.invalid"
NEXT_PUBLIC_GOOGLE_MAPS_URL=""
EXTERNAL_COMMUNICATIONS_MODE="blocked"

# Dedicated staging database. Its name must contain "staging".
DATABASE_ENVIRONMENT="staging"
DATABASE_URL="postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_HOST/salud_intercultural_staging?sslmode=require"

# Dedicated Payload secret and schema.
PAYLOAD_SECRET=""
PAYLOAD_SIGECO_INTEGRATION_SECRET=""
PAYLOAD_PUBLIC_SERVER_URL="https://staging.saludintercultural.com"
PAYLOAD_DB_SCHEMA="payload_staging"

# Dedicated staging Blob Store created with the STAGING_BLOB variable prefix.
# Never reuse or copy BLOB_READ_WRITE_TOKEN from production.
STORAGE_ENVIRONMENT="staging"
STAGING_BLOB_STORE_ID=""
STAGING_BLOB_READ_WRITE_TOKEN=""

# Separate PRIVATE Blob Store for clinical files. It must not be the Payload
# media store above.
CLINICAL_FILES_STORAGE_DRIVER="vercel-blob"
STAGING_CLINICAL_BLOB_READ_WRITE_TOKEN=""

# Payload admin for staging.
ADMIN_EMAIL="qa.admin@staging.invalid"
ADMIN_PASSWORD=""
ADMIN_RESET_PASSWORD_ON_SEED="true"
ADMIN_SESSION_SECONDS="14400"
ADMIN_LOCK_MINUTES="10"

# SIGECO QA accounts. The seed creates one account for every active role.
# Each login password is STAGING_QA_PASSWORD:<role>.
STAGING_QA_EMAIL_DOMAIN="staging.invalid"
STAGING_QA_PASSWORD=""
INTERNAL_SESSION_SECONDS="14400"
INTERNAL_LOCK_MINUTES="10"

RATE_LIMIT_MAX="30"
RATE_LIMIT_WINDOW_SECONDS="60"
CMS_READS_DURING_BUILD="false"
# No autoriza producción; staging usa la versión aprobada para pruebas.
PATIENT_CONSENT_PRODUCTION_TEXT_VERSION=
