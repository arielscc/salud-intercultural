generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InternalRole {
  super_admin
  direccion
  medico
  recepcion
  captacion
  administracion
  enfermeria
}

enum InternalPermission {
  internal_access
  leads_read
  leads_create
  leads_update
  leads_contact
  leads_reminder
  patients_read
  patients_create
  patients_update
  visits_read
  visits_create
  visits_update
  patient_route_read
  patient_route_update
  clinical_read
  clinical_write
  reports_read
}

enum InternalLeadSource {
  website
  whatsapp
  facebook_ads
  facebook_organic
  tiktok
  google
  call
  referral
  previous_patient
  flyer
  other
}

enum InternalLeadStatus {
  new
  contacted
  interested
  wants_visit
  reminder_pending
  confirmed_attendance
  no_answer
  discarded
  converted_to_patient
}

enum InternalLeadContactMethod {
  call
  whatsapp
  in_person
  other
}

enum InternalLeadContactResult {
  contacted
  no_answer
  interested
  wants_visit
  confirmed_attendance
  discarded
  follow_up_required
}

enum InternalLeadReminderStatus {
  pending
  completed
  cancelled
}

enum PatientGender {
  female
  male
  other
  unknown
}

enum PatientStatus {
  active
  inactive
  archived
}

enum PatientCaptureSource {
  facebook_ads
  facebook_organic
  tiktok
  whatsapp
  referral
  previous_patient
  flyer
  website
  other
}

enum VisitStatus {
  in_reception
  in_consultation
  in_nursing
  in_administration
  completed
  left_without_care
  cancelled
}

enum PatientRouteArea {
  recepcion
  medico
  enfermeria
  administracion
  seguimiento
  cierre
}

enum VisitWorkItemStatus {
  pending
  acknowledged
  in_progress
  completed
  cancelled
  blocked
}

enum DiagnosisKind {
  primary
  secondary
}

enum ClinicalOrderType {
  vital_signs
  study
  nursing_application
  serum
  medication
  administration
  follow_up
  other
}

enum ClinicalOrderStatus {
  pending
  acknowledged
  completed
  cancelled
  blocked
}

model InternalUser {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String?
  passwordHash   String
  role           InternalRole      @default(captacion)
  active         Boolean           @default(true)
  lastLoginAt    DateTime?
  failedAttempts Int               @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sessions       InternalSession[]
  assignedLeads  Lead[]            @relation("LeadAssignee")
  contactAttempts LeadContactAttempt[]
  reminders      LeadReminder[]
  statusChanges  LeadStatusHistory[]
  patientNotes    PatientNote[]
  createdVisits   Visit[]           @relation("VisitCreatedBy")
  visitStatusChanges VisitStatusHistory[]
  receptionCheckIns ReceptionCheckIn[]
  createdWorkItems VisitWorkItem[]
  clinicalConsultations ClinicalConsultation[]
  prescriptions Prescription[]
  clinicalEvolutions ClinicalEvolution[]
  clinicalNotes ClinicalNote[]
  clinicalOrders ClinicalOrder[]

  @@index([role])
  @@index([active])
}

model InternalSession {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime     @default(now())
  user      InternalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Lead {
  id                  String                    @id @default(cuid())
  name                String?
  phone               String
  email               String?
  city                String?
  symptoms            String?
  intentionToVisit    String?
  estimatedVisitDate  DateTime?
  commercialNotes     String?
  source              InternalLeadSource        @default(website)
  status              InternalLeadStatus        @default(new)
  pagePath            String?
  assignedToId        String?
  convertedPatientId  String?
  firstContactedAt    DateTime?
  lastContactedAt     DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  assignedTo          InternalUser?             @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedPatient    Patient?                  @relation("LeadConvertedPatient", fields: [convertedPatientId], references: [id], onDelete: SetNull)
  contactAttempts     LeadContactAttempt[]
  reminders           LeadReminder[]
  statusHistory       LeadStatusHistory[]

  @@index([createdAt])
  @@index([phone])
  @@index([status, createdAt])
  @@index([source])
  @@index([assignedToId])
  @@index([convertedPatientId])
}

model LeadContactAttempt {
  id          String                    @id @default(cuid())
  leadId      String
  userId      String?
  method      InternalLeadContactMethod @default(call)
  result      InternalLeadContactResult
  notes       String?
  contactedAt DateTime                  @default(now())
  createdAt   DateTime                  @default(now())
  lead        Lead                      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        InternalUser?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([contactedAt])
}

model LeadReminder {
  id          String                     @id @default(cuid())
  leadId      String
  userId      String?
  dueAt       DateTime
  note        String?
  status      InternalLeadReminderStatus @default(pending)
  completedAt DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  lead        Lead                       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        InternalUser?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([status, dueAt])
}

model LeadStatusHistory {
  id         String             @id @default(cuid())
  leadId     String
  userId     String?
  fromStatus InternalLeadStatus?
  toStatus   InternalLeadStatus
  note       String?
  createdAt  DateTime           @default(now())
  lead       Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user       InternalUser?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
}

model Patient {
  id                  String               @id @default(cuid())
  internalCode        String               @unique
  fullName            String
  phone               String
  secondaryPhone      String?
  birthDate           DateTime?
  gender              PatientGender        @default(unknown)
  city                String?
  department          String?
  address             String?
  captureSource       PatientCaptureSource @default(other)
  firstVisitAt        DateTime?
  generalObservations String?
  allergies           String?
  relevantHistory     String?
  status              PatientStatus        @default(active)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  convertedLeads      Lead[]               @relation("LeadConvertedPatient")
  contacts            PatientContact[]
  notes               PatientNote[]
  visits              Visit[]
  clinicalConsultations ClinicalConsultation[]
  prescriptions       Prescription[]
  clinicalEvolutions  ClinicalEvolution[]
  clinicalNotes       ClinicalNote[]
  clinicalOrders      ClinicalOrder[]

  @@index([fullName])
  @@index([phone])
  @@index([status])
  @@index([captureSource])
  @@index([createdAt])
}

model PatientContact {
  id        String   @id @default(cuid())
  patientId String
  label     String?
  phone     String
  createdAt DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([phone])
}

model PatientNote {
  id        String        @id @default(cuid())
  patientId String
  userId    String?
  note      String
  createdAt DateTime      @default(now())
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user      InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([userId])
  @@index([createdAt])
}

model Visit {
  id             String               @id @default(cuid())
  patientId      String
  status         VisitStatus          @default(in_reception)
  reason         String?
  createdById    String?
  checkedInAt    DateTime             @default(now())
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  patient        Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdBy      InternalUser?        @relation("VisitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  checkIn        ReceptionCheckIn?
  route          PatientRoute?
  statusHistory  VisitStatusHistory[]
  workItems      VisitWorkItem[]
  clinicalConsultation ClinicalConsultation?
  prescriptions Prescription[]
  clinicalEvolutions ClinicalEvolution[]
  clinicalNotes ClinicalNote[]
  clinicalOrders ClinicalOrder[]

  @@index([patientId])
  @@index([status, checkedInAt])
  @@index([createdById])
  @@index([checkedInAt])
}

model VisitStatusHistory {
  id         String        @id @default(cuid())
  visitId    String
  userId     String?
  fromStatus VisitStatus?
  toStatus   VisitStatus
  note       String?
  createdAt  DateTime      @default(now())
  visit      Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  user       InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([visitId])
  @@index([userId])
  @@index([createdAt])
}

model ClinicalConsultation {
  id                  String              @id @default(cuid())
  visitId             String              @unique
  patientId           String
  doctorId            String?
  motive              String
  findings            String?
  observations        String?
  treatmentPlanText   String?
  indications         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  visit               Visit               @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient             Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor              InternalUser?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  diagnoses           Diagnosis[]
  treatmentPlans      TreatmentPlan[]

  @@index([patientId])
  @@index([doctorId])
  @@index([createdAt])
}

model Diagnosis {
  id             String               @id @default(cuid())
  consultationId String
  kind           DiagnosisKind        @default(secondary)
  name           String
  findings       String?
  observations   String?
  createdAt      DateTime             @default(now())
  consultation   ClinicalConsultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@index([kind])
}

model TreatmentPlan {
  id             String               @id @default(cuid())
  consultationId String
  internalName   String?
  medications    String?
  dosage         String?
  duration       String?
  observations   String?
  createdAt      DateTime             @default(now())
  consultation   ClinicalConsultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
}

model Prescription {
  id        String             @id @default(cuid())
  visitId   String
  patientId String
  doctorId  String?
  notes     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  visit     Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient   Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor    InternalUser?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  items     PrescriptionItem[]

  @@index([visitId])
  @@index([patientId])
  @@index([doctorId])
  @@index([createdAt])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  medication     String
  dose           String?
  frequency      String?
  duration       String?
  observations   String?
  createdAt      DateTime     @default(now())
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

model ClinicalEvolution {
  id        String        @id @default(cuid())
  visitId   String
  patientId String
  userId    String?
  note      String
  createdAt DateTime      @default(now())
  visit     Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  user      InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([visitId])
  @@index([patientId])
  @@index([userId])
  @@index([createdAt])
}

model ClinicalNote {
  id        String        @id @default(cuid())
  visitId   String
  patientId String
  userId    String?
  note      String
  createdAt DateTime      @default(now())
  visit     Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  user      InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([visitId])
  @@index([patientId])
  @@index([userId])
  @@index([createdAt])
}

model ClinicalOrder {
  id          String              @id @default(cuid())
  visitId     String
  patientId   String
  doctorId    String?
  workItemId  String?
  type        ClinicalOrderType
  targetArea  PatientRouteArea
  status      ClinicalOrderStatus @default(pending)
  title       String
  details     String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  visit       Visit               @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor      InternalUser?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  workItem    VisitWorkItem?      @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([visitId])
  @@index([patientId])
  @@index([doctorId])
  @@index([targetArea, status])
  @@index([createdAt])
}

model ReceptionCheckIn {
  id        String        @id @default(cuid())
  visitId   String        @unique
  userId    String?
  note      String?
  createdAt DateTime      @default(now())
  visit     Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  user      InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model PatientRoute {
  id          String             @id @default(cuid())
  visitId     String             @unique
  currentArea PatientRouteArea   @default(recepcion)
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  visit       Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  steps       PatientRouteStep[]

  @@index([currentArea])
  @@index([active])
}

model PatientRouteStep {
  id        String           @id @default(cuid())
  routeId   String
  area      PatientRouteArea
  status    VisitStatus
  note      String?
  startedAt DateTime         @default(now())
  endedAt   DateTime?
  route     PatientRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId])
  @@index([area])
  @@index([startedAt])
}

model VisitWorkItem {
  id          String              @id @default(cuid())
  visitId     String
  createdById String?
  area        PatientRouteArea
  status      VisitWorkItemStatus @default(pending)
  title       String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  completedAt DateTime?
  visit       Visit               @relation(fields: [visitId], references: [id], onDelete: Cascade)
  createdBy   InternalUser?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  clinicalOrders ClinicalOrder[]

  @@index([visitId])
  @@index([createdById])
  @@index([area, status])
  @@index([createdAt])
}
