model InternalUser {
  id                             String                          @id @default(cuid())
  email                          String                          @unique
  name                           String?
  passwordHash                   String
  role                           InternalRole                    @default(captacion)
  active                         Boolean                         @default(true)
  lastLoginAt                    DateTime?
  failedAttempts                 Int                             @default(0)
  lockedUntil                    DateTime?
  mustChangePassword             Boolean                         @default(false)
  passwordChangedAt              DateTime?
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  sessions                       InternalSession[]
  assignedLeads                  Lead[]                          @relation("LeadAssignee")
  contactAttempts                LeadContactAttempt[]
  recordedPatientConsents        PatientConsent[]                @relation("PatientConsentRecordedBy")
  reminders                      LeadReminder[]
  statusChanges                  LeadStatusHistory[]
  patientNotes                   PatientNote[]
  createdVisits                  Visit[]                         @relation("VisitCreatedBy")
  visitStatusChanges             VisitStatusHistory[]
  receptionCheckIns              ReceptionCheckIn[]
  createdWorkItems               VisitWorkItem[]
  clinicalConsultations          ClinicalConsultation[]
  prescriptions                  Prescription[]
  clinicalEvolutions             ClinicalEvolution[]
  clinicalNotes                  ClinicalNote[]
  clinicalOrders                 ClinicalOrder[]
  recordedVitalSigns             VitalSigns[]
  nursingApplications            NursingApplication[]            @relation("NursingApplicationResponsible")
  nursingNotes                   NursingNote[]
  requestedStudies               Study[]                         @relation("StudyRequestedBy")
  recordedStudies                Study[]                         @relation("StudyRecordedBy")
  nursingWorkItemResults         NursingWorkItemResult[]
  createdSales                   Sale[]                          @relation("SaleCreatedBy")
  receivedPayments               Payment[]
  cashMovements                  CashMovement[]
  responsibleCashSessions        CashSession[]                   @relation("CashSessionResponsible")
  openedCashSessions             CashSession[]                   @relation("CashSessionOpenedBy")
  requestedCashClosures          CashSession[]                   @relation("CashSessionCloseRequestedBy")
  approvedCashSessions           CashSession[]                   @relation("CashSessionApprovedBy")
  closedCashSessions             CashSession[]                   @relation("CashSessionClosedBy")
  authorizedCashMovements        CashMovement[]                  @relation("CashMovementAuthorizedBy")
  registeredCashExpenses         CashExpense[]                   @relation("CashExpenseRegisteredBy")
  deliveredCashExpenses          CashExpense[]                   @relation("CashExpenseDeliveredBy")
  authorizedCashExpenses         CashExpense[]                   @relation("CashExpenseAuthorizedBy")
  requestedCashExpenses          CashExpense[]                   @relation("CashExpenseRequestedBy")
  receivedCashExpenses           CashExpense[]                   @relation("CashExpenseReceivedBy")
  cashExpenseBenefits            CashExpenseBeneficiary[]
  assignedFollowUps              FollowUpTask[]                  @relation("FollowUpAssignedTo")
  createdFollowUps               FollowUpTask[]                  @relation("FollowUpCreatedBy")
  followUpAttempts               FollowUpAttempt[]
  followUpStatusChanges          FollowUpStatusHistory[]
  inventoryMovements             InventoryMovement[]
  inventoryAdjustments           InventoryAdjustment[]
  inventoryCatalogVersions       InventoryItemCatalogVersion[]   @relation("InventoryCatalogVersionChangedBy")
  supplierVersions               SupplierVersion[]               @relation("SupplierVersionChangedBy")
  createdPurchases               Purchase[]                      @relation("PurchaseCreatedBy")
  confirmedPurchases             Purchase[]                      @relation("PurchaseConfirmedBy")
  cancelledPurchases             Purchase[]                      @relation("PurchaseCancelledBy")
  recordedPurchasePayments       PurchasePayment[]               @relation("PurchasePaymentRecordedBy")
  recordedPurchaseReceipts       PurchaseReceipt[]               @relation("PurchaseReceiptRecordedBy")
  receivedPurchaseReceipts       PurchaseReceipt[]               @relation("PurchaseReceiptReceivedBy")
  inventoryLotAdjustments        InventoryLotAdjustment[]        @relation("InventoryLotAdjustmentRecordedBy")
  authorizedLotAdjustments       InventoryLotAdjustment[]        @relation("InventoryLotAdjustmentAuthorizedBy")
  uploadedPurchaseDocuments      PurchaseDocument[]              @relation("PurchaseDocumentUploadedBy")
  auditEvents                    AuditEvent[]
  uploadedAttachments            ClinicalAttachment[]            @relation("ClinicalAttachmentUploadedBy")
  deletedAttachments             ClinicalAttachment[]            @relation("ClinicalAttachmentDeletedBy")
  attachmentAccessGrants         ClinicalAttachmentAccessGrant[]
  capturedAttributions           VisitAttribution[]              @relation("VisitAttributionCapturedBy")
  reviewedDuplicateCandidates    PatientDuplicateCandidate[]     @relation("PatientDuplicateCandidateReviewedBy")
  performedPatientMerges         PatientMerge[]                  @relation("PatientMergePerformedBy")
  treatmentProposalOutcomes      TreatmentProposalOutcome[]
  recordedDiscontinuations       VisitDiscontinuation[]          @relation("VisitDiscontinuationRecordedBy")
  finalizedConsultations         ClinicalConsultation[]          @relation("ClinicalConsultationFinalizedBy")
  authoredClinicalVersions       ClinicalConsultationVersion[]   @relation("ClinicalConsultationVersionAuthor")
  professionalProfile            ClinicalProfessionalProfile?    @relation("ProfessionalProfileUser")
  configuredProfessionalProfiles ClinicalProfessionalProfile[]   @relation("ProfessionalProfileConfiguredBy")
  generatedDocuments             GeneratedDocument[]             @relation("GeneratedDocumentGeneratedBy")
  recordedAreaTimeEvents         VisitAreaTimeEvent[]            @relation("VisitAreaTimeEventRecordedBy")

  @@index([role])
  @@index([active])
}

model InternalSession {
  id          String       @id @default(cuid())
  tokenHash   String       @unique
  userId      String
  deviceLabel String?
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  user        InternalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Historial técnico inmutable de acciones críticas dentro de SIGECO.
/// La aplicación solo puede insertar y consultar. Una protección adicional
/// en PostgreSQL rechaza UPDATE y DELETE incluso si se intentan con SQL directo.
model AuditEvent {
  id         String        @id @default(cuid())
  actorId    String?
  actorRole  InternalRole?
  action     String
  entityType String
  entityId   String?
  result     AuditResult
  requestId  String
  context    Json?
  occurredAt DateTime      @default(now())
  actor      InternalUser? @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@index([entityType, occurredAt])
  @@index([result, occurredAt])
}

model Lead {
  id                 String               @id @default(cuid())
  name               String?
  phone              String
  email              String?
  city               String?
  symptoms           String?
  intentionToVisit   String?
  estimatedVisitDate DateTime?
  commercialNotes    String?
  source             InternalLeadSource   @default(website)
  status             InternalLeadStatus   @default(new)
  pagePath           String?
  assignedToId       String?
  convertedPatientId String?
  firstContactedAt   DateTime?
  lastContactedAt    DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  assignedTo         InternalUser?        @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedPatient   Patient?             @relation("LeadConvertedPatient", fields: [convertedPatientId], references: [id], onDelete: SetNull)
  contactAttempts    LeadContactAttempt[]
  reminders          LeadReminder[]
  statusHistory      LeadStatusHistory[]
  followUpTasks      FollowUpTask[]

  @@index([createdAt])
  @@index([phone])
  @@index([status, createdAt])
  @@index([source])
  @@index([assignedToId])
  @@index([convertedPatientId])
}

model LeadContactAttempt {
  id          String                    @id @default(cuid())
  leadId      String
  userId      String?
  method      InternalLeadContactMethod @default(call)
  result      InternalLeadContactResult
  notes       String?
  contactedAt DateTime                  @default(now())
  createdAt   DateTime                  @default(now())
  lead        Lead                      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        InternalUser?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([contactedAt])
}

model LeadReminder {
  id          String                     @id @default(cuid())
  leadId      String
  userId      String?
  dueAt       DateTime
  note        String?
  status      InternalLeadReminderStatus @default(pending)
  completedAt DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  lead        Lead                       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        InternalUser?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([status, dueAt])
}

model LeadStatusHistory {
  id         String              @id @default(cuid())
  leadId     String
  userId     String?
  fromStatus InternalLeadStatus?
  toStatus   InternalLeadStatus
  note       String?
  createdAt  DateTime            @default(now())
  lead       Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user       InternalUser?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
}

model Patient {
  id                       String                      @id @default(cuid())
  internalCode             String                      @unique
  fullName                 String
  phone                    String
  secondaryPhone           String?
  birthDate                DateTime?
  gender                   PatientGender               @default(unknown)
  city                     String?
  department               String?
  country                  String?
  address                  String?
  captureSource            PatientCaptureSource        @default(other)
  captureSources           PatientCaptureSource[]      @default([])
  firstVisitAt             DateTime?
  generalObservations      String?
  allergies                String?
  relevantHistory          String?
  currentMedication        String?
  followUpPreference       FollowUpContactPreference   @default(unknown)
  status                   PatientStatus               @default(active)
  normalizedName           String                      @default("")
  normalizedPhone          String                      @default("")
  normalizedSecondaryPhone String                      @default("")
  mergedIntoId             String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  mergedInto               Patient?                    @relation("PatientMergeRedirect", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedPatients           Patient[]                   @relation("PatientMergeRedirect")
  convertedLeads           Lead[]                      @relation("LeadConvertedPatient")
  contacts                 PatientContact[]
  notes                    PatientNote[]
  visits                   Visit[]
  clinicalConsultations    ClinicalConsultation[]
  prescriptions            Prescription[]
  clinicalEvolutions       ClinicalEvolution[]
  clinicalNotes            ClinicalNote[]
  clinicalOrders           ClinicalOrder[]
  vitalSigns               VitalSigns[]
  nursingApplications      NursingApplication[]
  nursingNotes             NursingNote[]
  studies                  Study[]
  sales                    Sale[]
  payments                 Payment[]
  deliveredProducts        DeliveredProduct[]
  cashMovements            CashMovement[]
  followUpTasks            FollowUpTask[]
  clinicalAttachments      ClinicalAttachment[]
  consents                 PatientConsent[]
  visitAttributions        VisitAttribution[]
  duplicateCandidatesA     PatientDuplicateCandidate[] @relation("PatientDuplicateCandidateA")
  duplicateCandidatesB     PatientDuplicateCandidate[] @relation("PatientDuplicateCandidateB")
  mergesReceived           PatientMerge[]              @relation("PatientMergeTarget")
  mergeAsSource            PatientMerge?               @relation("PatientMergeSource")
  aliases                  PatientAlias[]              @relation("PatientAliasCanonical")
  aliasAsSource            PatientAlias?               @relation("PatientAliasSource")
  generatedDocuments       GeneratedDocument[]

  @@index([fullName])
  @@index([phone])
  @@index([normalizedPhone])
  @@index([normalizedSecondaryPhone])
  @@index([normalizedName, birthDate])
  @@index([mergedIntoId])
  @@index([status])
  @@index([captureSource])
  @@index([department, city])
  @@index([country])
  @@index([createdAt])
}

model PatientDuplicateCandidate {
  id             String                          @id @default(cuid())
  pairKey        String                          @unique
  patientAId     String
  patientBId     String
  phoneMatch     Boolean                         @default(false)
  nameMatch      Boolean                         @default(false)
  birthDateMatch Boolean                         @default(false)
  score          Int
  status         PatientDuplicateCandidateStatus @default(open)
  detectedAt     DateTime                        @default(now())
  lastDetectedAt DateTime                        @default(now())
  reviewedAt     DateTime?
  reviewedById   String?
  mergeId        String?                         @unique
  patientA       Patient                         @relation("PatientDuplicateCandidateA", fields: [patientAId], references: [id], onDelete: Restrict)
  patientB       Patient                         @relation("PatientDuplicateCandidateB", fields: [patientBId], references: [id], onDelete: Restrict)
  reviewedBy     InternalUser?                   @relation("PatientDuplicateCandidateReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  merge          PatientMerge?                   @relation(fields: [mergeId], references: [id], onDelete: SetNull)

  @@index([status, score, lastDetectedAt])
  @@index([patientAId, status])
  @@index([patientBId, status])
}

model PatientMerge {
  id              String                     @id @default(cuid())
  sourcePatientId String                     @unique
  targetPatientId String
  mergedById      String?
  sourceSnapshot  Json
  targetSnapshot  Json
  impact          Json
  mergedAt        DateTime                   @default(now())
  sourcePatient   Patient                    @relation("PatientMergeSource", fields: [sourcePatientId], references: [id], onDelete: Restrict)
  targetPatient   Patient                    @relation("PatientMergeTarget", fields: [targetPatientId], references: [id], onDelete: Restrict)
  mergedBy        InternalUser?              @relation("PatientMergePerformedBy", fields: [mergedById], references: [id], onDelete: SetNull)
  candidate       PatientDuplicateCandidate?

  @@index([targetPatientId, mergedAt])
  @@index([mergedById, mergedAt])
}

model PatientAlias {
  id                       String    @id @default(cuid())
  patientId                String
  sourcePatientId          String    @unique
  internalCode             String    @unique
  fullName                 String
  normalizedName           String
  phone                    String
  secondaryPhone           String?
  normalizedPhone          String
  normalizedSecondaryPhone String    @default("")
  birthDate                DateTime?
  createdAt                DateTime  @default(now())
  patient                  Patient   @relation("PatientAliasCanonical", fields: [patientId], references: [id], onDelete: Restrict)
  sourcePatient            Patient   @relation("PatientAliasSource", fields: [sourcePatientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([normalizedPhone])
  @@index([normalizedSecondaryPhone])
  @@index([normalizedName, birthDate])
}

model PatientConsent {
  id              String                      @id @default(cuid())
  patientId       String
  purpose         PatientConsentPurpose
  decision        PatientConsentDecision
  contactChannels PatientContactChannel[]     @default([])
  captureMethod   PatientConsentCaptureMethod
  textVersion     String
  textSnapshot    String
  decidedAt       DateTime                    @default(now())
  recordedById    String?
  supersedesId    String?                     @unique
  createdAt       DateTime                    @default(now())
  patient         Patient                     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  recordedBy      InternalUser?               @relation("PatientConsentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  supersedes      PatientConsent?             @relation("PatientConsentHistory", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy    PatientConsent?             @relation("PatientConsentHistory")

  @@index([patientId, purpose, decidedAt])
  @@index([patientId, decidedAt])
  @@index([purpose, decision, decidedAt])
  @@index([recordedById])
  @@index([createdAt])
}

model PatientContact {
  id        String   @id @default(cuid())
  patientId String
  label     String?
  phone     String
  createdAt DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([phone])
}

model PatientNote {
  id        String        @id @default(cuid())
  patientId String
  userId    String?
  note      String
  createdAt DateTime      @default(now())
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user      InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([userId])
  @@index([createdAt])
}

model Visit {
  id                        String                     @id @default(cuid())
  patientId                 String
  branchCode                String                     @default("el-alto")
  isTestData                Boolean                    @default(false)
  status                    VisitStatus                @default(in_reception)
  reason                    String?
  intakeType                VisitIntakeType            @default(first_visit)
  symptomDurationValue      Int?
  symptomDurationUnit       SymptomDurationUnit?
  previouslyTreated         Boolean?
  bringsStudies             Boolean                    @default(false)
  originCity                String                     @default("No informado")
  originDepartment          String?
  originCountry             String                     @default("No informado")
  originMatchesPatient      Boolean                    @default(true)
  createdById               String?
  checkedInAt               DateTime                   @default(now())
  completedAt               DateTime?
  cancelledAt               DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  patient                   Patient                    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdBy                 InternalUser?              @relation("VisitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  checkIn                   ReceptionCheckIn?
  route                     PatientRoute?
  statusHistory             VisitStatusHistory[]
  workItems                 VisitWorkItem[]
  clinicalConsultation      ClinicalConsultation?
  prescriptions             Prescription[]
  clinicalEvolutions        ClinicalEvolution[]
  clinicalNotes             ClinicalNote[]
  clinicalOrders            ClinicalOrder[]
  vitalSigns                VitalSigns[]
  nursingApplications       NursingApplication[]
  nursingNotes              NursingNote[]
  studies                   Study[]
  sales                     Sale[]
  payments                  Payment[]
  deliveredProducts         DeliveredProduct[]
  cashMovements             CashMovement[]
  followUpTasks             FollowUpTask[]
  clinicalAttachments       ClinicalAttachment[]
  attribution               VisitAttribution?
  treatmentProposalOutcomes TreatmentProposalOutcome[]
  discontinuation           VisitDiscontinuation?
  generatedDocuments        GeneratedDocument[]
  areaTimeEvents            VisitAreaTimeEvent[]

  @@index([patientId])
  @@index([branchCode, checkedInAt])
  @@index([status, checkedInAt])
  @@index([originDepartment, originCity, checkedInAt])
  @@index([originCountry, checkedInAt])
  @@index([createdById])
  @@index([checkedInAt])
}

/// Cierre específico cuando el paciente no continúa una visita.
/// Conserva el punto de salida y una fotografía de lo que quedó pendiente.
model VisitDiscontinuation {
  id             String                     @id @default(cuid())
  visitId        String                     @unique
  fromStatus     VisitStatus
  area           PatientRouteArea
  reason         VisitDiscontinuationReason
  pendingTypes   VisitPendingType[]         @default([])
  note           String?
  recordedById   String?
  followUpTaskId String?                    @unique
  occurredAt     DateTime                   @default(now())
  createdAt      DateTime                   @default(now())
  visit          Visit                      @relation(fields: [visitId], references: [id], onDelete: Restrict)
  recordedBy     InternalUser?              @relation("VisitDiscontinuationRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  followUpTask   FollowUpTask?              @relation(fields: [followUpTaskId], references: [id], onDelete: SetNull)

  @@index([reason, occurredAt])
  @@index([area, occurredAt])
  @@index([recordedById, occurredAt])
  @@index([occurredAt])
}

model CaptureSource {
  id                  String                  @id @default(cuid())
  code                String                  @unique
  patientLabel        String
  internalLabel       String
  category            CaptureSourceCategory
  active              Boolean                 @default(true)
  receptionSelectable Boolean                 @default(true)
  sortOrder           Int                     @default(100)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @default(now()) @updatedAt
  campaigns           CaptureCampaign[]
  attributionTouches  VisitAttributionTouch[]

  @@index([active, receptionSelectable, sortOrder])
  @@index([category])
}

model CaptureCampaign {
  id            String                 @id @default(cuid())
  code          String                 @unique
  name          String
  sourceId      String
  accountLabel  String?
  accountHandle String?
  trafficType   AttributionTrafficType @default(unidentified)
  active        Boolean                @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @default(now()) @updatedAt
  source        CaptureSource          @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  attributions  VisitAttribution[]

  @@index([sourceId, active])
  @@index([active, startsAt, endsAt])
}

model VisitAttribution {
  id                   String                  @id @default(cuid())
  visitId              String                  @unique
  patientId            String
  capturedById         String?
  campaignId           String?
  evidenceKind         AttributionEvidenceKind @default(patient_reported)
  externalEvidenceCode String?
  createdAt            DateTime                @default(now())
  visit                Visit                   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient              Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  capturedBy           InternalUser?           @relation("VisitAttributionCapturedBy", fields: [capturedById], references: [id], onDelete: SetNull)
  campaign             CaptureCampaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  touches              VisitAttributionTouch[]

  @@index([patientId, createdAt])
  @@index([campaignId, createdAt])
  @@index([evidenceKind, createdAt])
}

model VisitAttributionTouch {
  id                    String                  @id @default(cuid())
  attributionId         String
  sourceId              String
  role                  AttributionTouchRole
  evidenceKind          AttributionEvidenceKind
  trafficType           AttributionTrafficType  @default(unidentified)
  accountLabel          String?
  accountHandle         String?
  campaignCode          String?
  automaticallyCaptured Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  attribution           VisitAttribution        @relation(fields: [attributionId], references: [id], onDelete: Cascade)
  source                CaptureSource           @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([attributionId, sourceId])
  @@index([sourceId, role, createdAt])
  @@index([campaignCode, createdAt])
}

model VisitStatusHistory {
  id         String        @id @default(cuid())
  visitId    String
  userId     String?
  fromStatus VisitStatus?
  toStatus   VisitStatus
  note       String?
  createdAt  DateTime      @default(now())
  visit      Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  user       InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([visitId])
  @@index([userId])
  @@index([createdAt])
}

model ClinicalConsultation {
  id                        String                        @id @default(cuid())
  visitId                   String                        @unique
  patientId                 String
  doctorId                  String?
  status                    ClinicalRecordStatus          @default(draft)
  revision                  Int                           @default(1)
  finalizedById             String?
  finalizedAt               DateTime?
  motive                    String
  findings                  String?
  observations              String?
  treatmentPlanText         String?
  indications               String?
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  visit                     Visit                         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient                   Patient                       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor                    InternalUser?                 @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  finalizedBy               InternalUser?                 @relation("ClinicalConsultationFinalizedBy", fields: [finalizedById], references: [id], onDelete: Restrict)
  diagnoses                 Diagnosis[]
  treatmentPlans            TreatmentPlan[]
  treatmentProposalOutcomes TreatmentProposalOutcome[]
  versions                  ClinicalConsultationVersion[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status, finalizedAt])
  @@index([finalizedById])
  @@index([createdAt])
}

/// Fotografía inmutable de una consulta en cada guardado, cierre o corrección.
/// La tabla principal es la proyección vigente; estas versiones conservan la historia.
model ClinicalConsultationVersion {
  id                 String                    @id @default(cuid())
  consultationId     String
  version            Int
  kind               ClinicalRecordVersionKind
  correctionType     ClinicalCorrectionType?
  correctionReason   String?
  authorId           String?
  motive             String
  primaryDiagnosis   String?
  secondaryDiagnosis String?
  findings           String?
  observations       String?
  treatmentPlanText  String?
  indications        String?
  createdAt          DateTime                  @default(now())
  consultation       ClinicalConsultation      @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  author             InternalUser?             @relation("ClinicalConsultationVersionAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([consultationId, version])
  @@index([consultationId, createdAt])
  @@index([authorId, createdAt])
  @@index([kind, createdAt])
}

model Diagnosis {
  id             String               @id @default(cuid())
  consultationId String
  kind           DiagnosisKind        @default(secondary)
  name           String
  findings       String?
  observations   String?
  createdAt      DateTime             @default(now())
  consultation   ClinicalConsultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@index([kind])
}

model TreatmentPlan {
  id             String               @id @default(cuid())
  consultationId String
  internalName   String?
  medications    String?
  dosage         String?
  duration       String?
  observations   String?
  createdAt      DateTime             @default(now())
  consultation   ClinicalConsultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
}

/// Decisión inmutable registrada después de explicar una propuesta.
/// Si la decisión cambia se inserta otro evento que referencia al anterior.
model TreatmentProposalOutcome {
  id                        String                         @id @default(cuid())
  consultationId            String
  visitId                   String
  doctorId                  String?
  status                    TreatmentProposalOutcomeStatus
  reason                    TreatmentProposalOutcomeReason
  note                      String?
  administrationInstruction String?
  administrationOrderId     String?                        @unique
  followUpTaskId            String?                        @unique
  supersedesId              String?                        @unique
  decidedAt                 DateTime                       @default(now())
  createdAt                 DateTime                       @default(now())
  consultation              ClinicalConsultation           @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  visit                     Visit                          @relation(fields: [visitId], references: [id], onDelete: Restrict)
  doctor                    InternalUser?                  @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  administrationOrder       ClinicalOrder?                 @relation(fields: [administrationOrderId], references: [id], onDelete: Restrict)
  followUpTask              FollowUpTask?                  @relation(fields: [followUpTaskId], references: [id], onDelete: Restrict)
  supersedes                TreatmentProposalOutcome?      @relation("TreatmentProposalOutcomeHistory", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy              TreatmentProposalOutcome?      @relation("TreatmentProposalOutcomeHistory")

  @@index([consultationId, decidedAt])
  @@index([visitId, decidedAt])
  @@index([doctorId, decidedAt])
  @@index([status, decidedAt])
  @@index([reason, decidedAt])
}

model Prescription {
  id                 String              @id @default(cuid())
  visitId            String
  patientId          String
  doctorId           String?
  version            Int                 @default(1)
  supersedesId       String?             @unique
  correctionReason   String?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  visit              Visit               @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient            Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor             InternalUser?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  supersedes         Prescription?       @relation("PrescriptionHistory", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy       Prescription?       @relation("PrescriptionHistory")
  items              PrescriptionItem[]
  generatedDocuments GeneratedDocument[]

  @@unique([visitId, version])
  @@index([visitId])
  @@index([patientId])
  @@index([doctorId])
  @@index([createdAt])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  medication     String
  dose           String?
  frequency      String?
  duration       String?
  observations   String?
  createdAt      DateTime     @default(now())
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

model ClinicalEvolution {
  id        String        @id @default(cuid())
  visitId   String
  patientId String
  userId    String?
  note      String
  createdAt DateTime      @default(now())
  visit     Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  user      InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([visitId])
  @@index([patientId])
  @@index([userId])
  @@index([createdAt])
}

model ClinicalNote {
  id        String        @id @default(cuid())
  visitId   String
  patientId String
  userId    String?
  note      String
  createdAt DateTime      @default(now())
  visit     Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  user      InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([visitId])
  @@index([patientId])
  @@index([userId])
  @@index([createdAt])
}

model ClinicalOrder {
  id                       String                    @id @default(cuid())
  visitId                  String
  patientId                String
  doctorId                 String?
  workItemId               String?
  type                     ClinicalOrderType
  targetArea               PatientRouteArea
  status                   ClinicalOrderStatus       @default(pending)
  title                    String
  details                  String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  visit                    Visit                     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient                  Patient                   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor                   InternalUser?             @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  workItem                 VisitWorkItem?            @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  nursingApplications      NursingApplication[]
  studies                  Study[]
  nursingWorkItemResults   NursingWorkItemResult[]
  followUpTasks            FollowUpTask[]
  treatmentProposalOutcome TreatmentProposalOutcome?

  @@index([visitId])
  @@index([patientId])
  @@index([doctorId])
  @@index([targetArea, status])
  @@index([createdAt])
}

model ReceptionCheckIn {
  id        String        @id @default(cuid())
  visitId   String        @unique
  userId    String?
  note      String?
  createdAt DateTime      @default(now())
  visit     Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  user      InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model PatientRoute {
  id          String             @id @default(cuid())
  visitId     String             @unique
  currentArea PatientRouteArea   @default(recepcion)
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  visit       Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  steps       PatientRouteStep[]

  @@index([currentArea])
  @@index([active])
}

model PatientRouteStep {
  id         String               @id @default(cuid())
  routeId    String
  area       PatientRouteArea
  status     VisitStatus
  note       String?
  startedAt  DateTime             @default(now())
  endedAt    DateTime?
  route      PatientRoute         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  timeEvents VisitAreaTimeEvent[]

  @@index([routeId])
  @@index([area])
  @@index([startedAt])
}

/// Eventos inmutables para medir espera, atención y bloqueo por área.
/// Los eventos inferidos provienen del recorrido anterior a la Tarea 23 y no
/// se usan para atribuir una fase de espera o atención que nunca fue registrada.
model VisitAreaTimeEvent {
  id           String                 @id @default(cuid())
  visitId      String
  routeStepId  String
  area         PatientRouteArea
  type         VisitAreaTimeEventType
  sequence     Int
  reason       String?
  inferred     Boolean                @default(false)
  recordedById String?
  occurredAt   DateTime               @default(now())
  createdAt    DateTime               @default(now())
  visit        Visit                  @relation(fields: [visitId], references: [id], onDelete: Restrict)
  routeStep    PatientRouteStep       @relation(fields: [routeStepId], references: [id], onDelete: Restrict)
  recordedBy   InternalUser?          @relation("VisitAreaTimeEventRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([routeStepId, sequence])
  @@index([visitId, occurredAt])
  @@index([routeStepId, occurredAt])
  @@index([area, occurredAt])
  @@index([type, occurredAt])
}

model VisitWorkItem {
  id                     String                  @id @default(cuid())
  visitId                String
  createdById            String?
  area                   PatientRouteArea
  status                 VisitWorkItemStatus     @default(pending)
  title                  String
  description            String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  completedAt            DateTime?
  visit                  Visit                   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  createdBy              InternalUser?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  clinicalOrders         ClinicalOrder[]
  nursingApplications    NursingApplication[]
  studies                Study[]
  nursingWorkItemResults NursingWorkItemResult[]
  sales                  Sale[]
  followUpTasks          FollowUpTask[]

  @@index([visitId])
  @@index([createdById])
  @@index([area, status])
  @@index([createdAt])
}

model Study {
  id              String               @id @default(cuid())
  patientId       String
  visitId         String?
  clinicalOrderId String?
  workItemId      String?
  requestedById   String?
  recordedById    String?
  type            StudyType            @default(other)
  status          StudyStatus          @default(performed)
  title           String
  resultSummary   String?
  findings        String?
  performedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  patient         Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit           Visit?               @relation(fields: [visitId], references: [id], onDelete: SetNull)
  clinicalOrder   ClinicalOrder?       @relation(fields: [clinicalOrderId], references: [id], onDelete: SetNull)
  workItem        VisitWorkItem?       @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  requestedBy     InternalUser?        @relation("StudyRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  recordedBy      InternalUser?        @relation("StudyRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  attachments     ClinicalAttachment[]

  @@index([patientId])
  @@index([visitId])
  @@index([clinicalOrderId])
  @@index([workItemId])
  @@index([type, status])
  @@index([performedAt])
  @@index([createdAt])
}

model VitalSigns {
  id                    String        @id @default(cuid())
  patientId             String
  visitId               String?
  recordedById          String?
  temperatureCelsius    Decimal?      @db.Decimal(4, 1)
  systolicPressureMmHg  Int?
  diastolicPressureMmHg Int?
  heartRateBpm          Int?
  respiratoryRateRpm    Int?
  oxygenSaturation      Int?
  weightKg              Decimal?      @db.Decimal(5, 2)
  heightCm              Decimal?      @db.Decimal(5, 2)
  notes                 String?
  recordedAt            DateTime      @default(now())
  createdAt             DateTime      @default(now())
  patient               Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit                 Visit?        @relation(fields: [visitId], references: [id], onDelete: SetNull)
  recordedBy            InternalUser? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([visitId])
  @@index([recordedById])
  @@index([recordedAt])
}

model NursingApplication {
  id              String         @id @default(cuid())
  patientId       String
  visitId         String?
  clinicalOrderId String?
  workItemId      String?
  responsibleId   String?
  medication      String
  quantity        String?
  route           String?
  appliedAt       DateTime       @default(now())
  notes           String?
  createdAt       DateTime       @default(now())
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit           Visit?         @relation(fields: [visitId], references: [id], onDelete: SetNull)
  clinicalOrder   ClinicalOrder? @relation(fields: [clinicalOrderId], references: [id], onDelete: SetNull)
  workItem        VisitWorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  responsible     InternalUser?  @relation("NursingApplicationResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([visitId])
  @@index([clinicalOrderId])
  @@index([workItemId])
  @@index([responsibleId])
  @@index([appliedAt])
}

model NursingNote {
  id        String        @id @default(cuid())
  patientId String
  visitId   String?
  userId    String?
  note      String
  createdAt DateTime      @default(now())
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit     Visit?        @relation(fields: [visitId], references: [id], onDelete: SetNull)
  user      InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([visitId])
  @@index([userId])
  @@index([createdAt])
}

model ClinicalAttachment {
  id               String                          @id @default(cuid())
  patientId        String
  visitId          String?
  studyId          String?
  uploadedById     String?
  deletedById      String?
  uploadRequestId  String                          @unique
  label            String
  contentType      String
  fileExtension    String
  sizeBytes        Int
  checksumSha256   String
  storageDriver    ClinicalAttachmentStorageDriver
  storageKey       String                          @unique
  status           ClinicalAttachmentStatus        @default(pending)
  scanStatus       ClinicalAttachmentScanStatus    @default(basic_validation_only)
  scanProvider     String?
  scannedAt        DateTime?
  quarantineReason String?
  notes            String?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  deletedAt        DateTime?
  patient          Patient                         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit            Visit?                          @relation(fields: [visitId], references: [id], onDelete: SetNull)
  study            Study?                          @relation(fields: [studyId], references: [id], onDelete: SetNull)
  uploadedBy       InternalUser?                   @relation("ClinicalAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  deletedBy        InternalUser?                   @relation("ClinicalAttachmentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  accessGrants     ClinicalAttachmentAccessGrant[]

  @@index([patientId])
  @@index([visitId])
  @@index([studyId])
  @@index([uploadedById])
  @@index([status, createdAt])
  @@index([checksumSha256])
  @@index([createdAt])
}

model ClinicalAttachmentAccessGrant {
  id           String                          @id @default(cuid())
  attachmentId String
  userId       String
  tokenHash    String                          @unique
  purpose      ClinicalAttachmentAccessPurpose
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime                        @default(now())
  attachment   ClinicalAttachment              @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  user         InternalUser                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([attachmentId, expiresAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model NursingWorkItemResult {
  id              String              @id @default(cuid())
  workItemId      String
  clinicalOrderId String?
  userId          String?
  status          VisitWorkItemStatus
  outcome         String?
  notes           String?
  createdAt       DateTime            @default(now())
  workItem        VisitWorkItem       @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  clinicalOrder   ClinicalOrder?      @relation(fields: [clinicalOrderId], references: [id], onDelete: SetNull)
  user            InternalUser?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workItemId])
  @@index([clinicalOrderId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Sale {
  id                 String              @id @default(cuid())
  patientId          String
  visitId            String?
  workItemId         String?
  createdById        String?
  status             SaleStatus          @default(pending)
  subtotalCents      Int                 @default(0)
  discountCents      Int                 @default(0)
  totalCents         Int                 @default(0)
  paidCents          Int                 @default(0)
  balanceCents       Int                 @default(0)
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  patient            Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit              Visit?              @relation(fields: [visitId], references: [id], onDelete: SetNull)
  workItem           VisitWorkItem?      @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  createdBy          InternalUser?       @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items              SaleItem[]
  payments           Payment[]
  deliveredProducts  DeliveredProduct[]
  cashMovements      CashMovement[]
  followUpTasks      FollowUpTask[]
  inventoryMovements InventoryMovement[]
  generatedDocuments GeneratedDocument[]

  @@index([patientId])
  @@index([visitId])
  @@index([workItemId])
  @@index([createdById])
  @@index([status, createdAt])
  @@index([createdAt])
}

/// Identidad profesional confirmada para mostrar en recetas preparadas para
/// firma y sello. No representa una firma electrónica.
model ClinicalProfessionalProfile {
  id                         String        @id @default(cuid())
  userId                     String        @unique
  displayName                String
  professionalTitle          String
  specialty                  String
  ministryRegistration       String
  medicalCollegeRegistration String
  active                     Boolean       @default(true)
  configuredById             String?
  configuredAt               DateTime      @default(now())
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  user                       InternalUser  @relation("ProfessionalProfileUser", fields: [userId], references: [id], onDelete: Restrict)
  configuredBy               InternalUser? @relation("ProfessionalProfileConfiguredBy", fields: [configuredById], references: [id], onDelete: SetNull)

  @@index([active])
  @@index([configuredById])
}

/// Fotografía inmutable de una receta o un comprobante interno emitido.
/// El PDF se reconstruye desde `snapshot`; nunca desde datos que luego cambian.
model GeneratedDocument {
  id                String                @id @default(cuid())
  kind              GeneratedDocumentKind
  documentNumber    String                @unique
  seriesKey         String
  version           Int
  schemaVersion     Int                   @default(1)
  patientId         String
  visitId           String?
  prescriptionId    String?
  saleId            String?
  generatedById     String
  supersedesId      String?               @unique
  sourceFingerprint String
  snapshot          Json
  generatedAt       DateTime              @default(now())
  patient           Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit             Visit?                @relation(fields: [visitId], references: [id], onDelete: Restrict)
  prescription      Prescription?         @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  sale              Sale?                 @relation(fields: [saleId], references: [id], onDelete: Restrict)
  generatedBy       InternalUser          @relation("GeneratedDocumentGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  supersedes        GeneratedDocument?    @relation("GeneratedDocumentHistory", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy      GeneratedDocument?    @relation("GeneratedDocumentHistory")

  @@unique([seriesKey, version])
  @@unique([seriesKey, sourceFingerprint])
  @@index([kind, generatedAt])
  @@index([patientId, generatedAt])
  @@index([visitId])
  @@index([prescriptionId])
  @@index([saleId])
  @@index([generatedById])
}

model SaleItem {
  id                 String              @id @default(cuid())
  saleId             String
  inventoryItemId    String?
  type               SaleItemType        @default(other)
  description        String
  quantity           Int                 @default(1)
  unitPriceCents     Int
  totalCents         Int
  delivered          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  sale               Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  inventoryItem      InventoryItem?      @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  deliveredProducts  DeliveredProduct[]
  inventoryMovements InventoryMovement[]

  @@index([saleId])
  @@index([inventoryItemId])
  @@index([type])
}

model PaymentMethod {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  payments  Payment[]
}

model Payment {
  id            String         @id @default(cuid())
  saleId        String
  patientId     String
  visitId       String?
  methodId      String
  receivedById  String?
  amountCents   Int
  reference     String?
  notes         String?
  paidAt        DateTime       @default(now())
  createdAt     DateTime       @default(now())
  sale          Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit         Visit?         @relation(fields: [visitId], references: [id], onDelete: SetNull)
  method        PaymentMethod  @relation(fields: [methodId], references: [id], onDelete: Restrict)
  receivedBy    InternalUser?  @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  cashMovements CashMovement[]

  @@index([saleId])
  @@index([patientId])
  @@index([visitId])
  @@index([methodId])
  @@index([receivedById])
  @@index([paidAt])
}

model DeliveredProduct {
  id          String    @id @default(cuid())
  saleId      String
  saleItemId  String?
  patientId   String
  visitId     String?
  description String
  quantity    Int       @default(1)
  deliveredAt DateTime  @default(now())
  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleItem    SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: SetNull)
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit       Visit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([saleItemId])
  @@index([patientId])
  @@index([visitId])
  @@index([deliveredAt])
}

model CashMovement {
  id                 String            @id @default(cuid())
  cashSessionId      String?
  saleId             String?
  paymentId          String?
  patientId          String?
  visitId            String?
  userId             String?
  authorizedById     String?
  originalMovementId String?
  idempotencyKey     String?           @unique
  type               CashMovementType  @default(income)
  channel            CashChannel       @default(cash)
  amountCents        Int
  description        String
  reason             String?
  note               String?
  occurredAt         DateTime          @default(now())
  createdAt          DateTime          @default(now())
  cashSession        CashSession?      @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  sale               Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  payment            Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  patient            Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  visit              Visit?            @relation(fields: [visitId], references: [id], onDelete: SetNull)
  user               InternalUser?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorizedBy       InternalUser?     @relation("CashMovementAuthorizedBy", fields: [authorizedById], references: [id], onDelete: SetNull)
  originalMovement   CashMovement?     @relation("CashMovementCorrections", fields: [originalMovementId], references: [id], onDelete: Restrict)
  corrections        CashMovement[]    @relation("CashMovementCorrections")
  expense            CashExpense?
  purchasePayments   PurchasePayment[]

  @@index([cashSessionId, occurredAt])
  @@index([saleId])
  @@index([paymentId])
  @@index([patientId])
  @@index([visitId])
  @@index([userId])
  @@index([authorizedById])
  @@index([originalMovementId])
  @@index([type, occurredAt])
}

model CashSession {
  id                 String                      @id @default(cuid())
  branchCode         String
  registerName       String
  businessDate       DateTime                    @db.Date
  shift              CashShift                   @default(full_day)
  responsibleId      String
  openedById         String
  closeRequestedById String?
  approvedById       String?
  closedById         String?
  idempotencyKey     String                      @unique
  status             CashSessionStatus           @default(open)
  openingCashCents   Int
  expectedCashCents  Int?
  countedCashCents   Int?
  differenceCents    Int?
  closeObservation   String?
  openedAt           DateTime                    @default(now())
  closeRequestedAt   DateTime?
  approvedAt         DateTime?
  closedAt           DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  responsible        InternalUser                @relation("CashSessionResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  openedBy           InternalUser                @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closeRequestedBy   InternalUser?               @relation("CashSessionCloseRequestedBy", fields: [closeRequestedById], references: [id], onDelete: Restrict)
  approvedBy         InternalUser?               @relation("CashSessionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  closedBy           InternalUser?               @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  movements          CashMovement[]
  expenses           CashExpense[]
  purchasePayments   PurchasePayment[]
  reconciliations    CashSessionReconciliation[]

  @@index([status, openedAt])
  @@index([branchCode, registerName, businessDate])
  @@index([responsibleId])
}

model CashSessionReconciliation {
  id              String      @id @default(cuid())
  cashSessionId   String
  channel         CashChannel
  expectedCents   Int
  reportedCents   Int
  differenceCents Int
  createdAt       DateTime    @default(now())
  cashSession     CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)

  @@unique([cashSessionId, channel])
  @@index([channel, createdAt])
}

model CashExpense {
  id                     String                           @id @default(cuid())
  cashSessionId          String
  movementId             String                           @unique
  registeredById         String
  deliveredById          String
  authorizedById         String
  requestedById          String?
  receivedById           String?
  idempotencyKey         String                           @unique
  kind                   CashExpenseKind
  category               CashExpenseCategory
  totalCents             Int
  reason                 String
  note                   String?
  itemDescription        String?
  quantity               Int?
  unitPriceCents         Int?
  supplierName           String?
  urgencyReason          String?
  requiresInventoryEntry Boolean                          @default(false)
  receiptStorageKey      String?
  receiptStorageDriver   ClinicalAttachmentStorageDriver?
  receiptOriginalName    String?
  receiptMimeType        String?
  receiptSizeBytes       Int?
  receiptChecksumSha256  String?
  receiptUploadedAt      DateTime?
  occurredAt             DateTime                         @default(now())
  createdAt              DateTime                         @default(now())
  cashSession            CashSession                      @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  movement               CashMovement                     @relation(fields: [movementId], references: [id], onDelete: Restrict)
  registeredBy           InternalUser                     @relation("CashExpenseRegisteredBy", fields: [registeredById], references: [id], onDelete: Restrict)
  deliveredBy            InternalUser                     @relation("CashExpenseDeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict)
  authorizedBy           InternalUser                     @relation("CashExpenseAuthorizedBy", fields: [authorizedById], references: [id], onDelete: Restrict)
  requestedBy            InternalUser?                    @relation("CashExpenseRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  receivedBy             InternalUser?                    @relation("CashExpenseReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  beneficiaries          CashExpenseBeneficiary[]
  purchase               Purchase?

  @@index([cashSessionId, occurredAt])
  @@index([kind, category, occurredAt])
  @@index([registeredById])
  @@index([authorizedById])
}

model CashExpenseBeneficiary {
  id            String       @id @default(cuid())
  cashExpenseId String
  employeeId    String
  amountCents   Int
  note          String?
  createdAt     DateTime     @default(now())
  cashExpense   CashExpense  @relation(fields: [cashExpenseId], references: [id], onDelete: Restrict)
  employee      InternalUser @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([cashExpenseId])
  @@index([employeeId, createdAt])
}

model FollowUpTask {
  id                       String                    @id @default(cuid())
  leadId                   String?
  patientId                String?
  visitId                  String?
  saleId                   String?
  clinicalOrderId          String?
  workItemId               String?
  assignedToId             String?
  createdById              String?
  escalatedFromTaskId      String?                   @unique
  type                     FollowUpType              @default(administrative)
  domain                   FollowUpDomain            @default(administrative)
  priority                 FollowUpPriority          @default(normal)
  status                   FollowUpStatus            @default(pending)
  result                   FollowUpResult?
  title                    String
  notes                    String?
  dueAt                    DateTime
  completedAt              DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  lead                     Lead?                     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  patient                  Patient?                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visit                    Visit?                    @relation(fields: [visitId], references: [id], onDelete: SetNull)
  sale                     Sale?                     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  clinicalOrder            ClinicalOrder?            @relation(fields: [clinicalOrderId], references: [id], onDelete: SetNull)
  workItem                 VisitWorkItem?            @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  assignedTo               InternalUser?             @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy                InternalUser?             @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  escalatedFromTask        FollowUpTask?             @relation("FollowUpEscalation", fields: [escalatedFromTaskId], references: [id], onDelete: SetNull)
  escalatedToTask          FollowUpTask?             @relation("FollowUpEscalation")
  attempts                 FollowUpAttempt[]
  statusHistory            FollowUpStatusHistory[]
  treatmentProposalOutcome TreatmentProposalOutcome?
  visitDiscontinuation     VisitDiscontinuation?

  @@index([leadId])
  @@index([patientId])
  @@index([visitId])
  @@index([saleId])
  @@index([clinicalOrderId])
  @@index([workItemId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status, dueAt])
  @@index([type, status, dueAt])
  @@index([domain, status, dueAt])
  @@index([priority, status, dueAt])
  @@index([result, completedAt])
  @@index([createdAt])
}

model FollowUpAttempt {
  id          String                @id @default(cuid())
  taskId      String
  userId      String?
  method      FollowUpAttemptMethod @default(call)
  result      FollowUpResult
  notes       String?
  contactedAt DateTime              @default(now())
  createdAt   DateTime              @default(now())
  task        FollowUpTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        InternalUser?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([userId])
  @@index([result])
  @@index([contactedAt])
}

model FollowUpStatusHistory {
  id         String          @id @default(cuid())
  taskId     String
  userId     String?
  fromStatus FollowUpStatus?
  toStatus   FollowUpStatus
  note       String?
  createdAt  DateTime        @default(now())
  task       FollowUpTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       InternalUser?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
}

model FollowUpTemplate {
  id        String   @id @default(cuid())
  title     String
  body      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active])
}

model Supplier {
  id          String                  @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  whatsapp    String?
  email       String?
  address     String?
  notes       String?
  active      Boolean                 @default(true)
  revision    Int                     @default(1)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  itemLinks   InventoryItemSupplier[]
  versions    SupplierVersion[]
  purchases   Purchase[]
  lots        InventoryLot[]

  @@index([name])
  @@index([active])
}

model InventoryItem {
  id                 String                        @id @default(cuid())
  sku                String?                       @unique
  internalCode       String                        @unique
  name               String
  description        String?
  category           String                        @default("Sin categoría")
  unit               String                        @default("unidad")
  usage              InventoryItemUsage            @default(both)
  salePriceCents     Int                           @default(0)
  referenceCostCents Int                           @default(0)
  currentStock       Int                           @default(0)
  minimumStock       Int                           @default(0)
  active             Boolean                       @default(true)
  revision           Int                           @default(1)
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  saleItems          SaleItem[]
  movements          InventoryMovement[]
  adjustments        InventoryAdjustment[]
  alerts             InventoryAlert[]
  supplierLinks      InventoryItemSupplier[]
  catalogVersions    InventoryItemCatalogVersion[]
  purchaseLines      PurchaseLine[]
  receiptLines       PurchaseReceiptLine[]
  lots               InventoryLot[]
  lotAdjustments     InventoryLotAdjustment[]

  @@index([name])
  @@index([category])
  @@index([usage])
  @@index([active])
  @@index([currentStock])
}

model InventoryItemSupplier {
  id         String        @id @default(cuid())
  itemId     String
  supplierId String
  preferred  Boolean       @default(false)
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  supplier   Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([itemId, supplierId])
  @@index([itemId, active])
  @@index([supplierId, active])
}

model InventoryItemCatalogVersion {
  id                 String             @id @default(cuid())
  itemId             String
  version            Int
  sku                String?
  internalCode       String
  name               String
  description        String?
  category           String
  unit               String
  usage              InventoryItemUsage
  salePriceCents     Int
  referenceCostCents Int
  minimumStock       Int
  active             Boolean
  supplierSnapshot   Json?
  changedById        String?
  changeReason       String
  createdAt          DateTime           @default(now())
  item               InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  changedBy          InternalUser?      @relation("InventoryCatalogVersionChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([itemId, version])
  @@index([itemId, createdAt])
  @@index([changedById])
}

model SupplierVersion {
  id           String        @id @default(cuid())
  supplierId   String
  version      Int
  name         String
  contactName  String?
  phone        String?
  whatsapp     String?
  email        String?
  address      String?
  notes        String?
  active       Boolean
  changedById  String?
  changeReason String
  createdAt    DateTime      @default(now())
  supplier     Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  changedBy    InternalUser? @relation("SupplierVersionChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([supplierId, version])
  @@index([supplierId, createdAt])
  @@index([changedById])
}

model Purchase {
  id                    String                @id @default(cuid())
  purchaseNumber        String                @unique
  supplierId            String
  sourceCashExpenseId   String?               @unique
  createdById           String
  confirmedById         String?
  cancelledById         String?
  branchCode            String
  purchaseDate          DateTime              @db.Date
  documentNumber        String?
  currency              String                @default("BOB")
  status                PurchaseStatus        @default(draft)
  intendedPaymentMethod PurchasePaymentMethod @default(credit)
  totalCents            Int
  notes                 String?
  revision              Int                   @default(1)
  idempotencyKey        String                @unique
  confirmedAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  supplier              Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sourceCashExpense     CashExpense?          @relation(fields: [sourceCashExpenseId], references: [id], onDelete: Restrict)
  createdBy             InternalUser          @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy           InternalUser?         @relation("PurchaseConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  cancelledBy           InternalUser?         @relation("PurchaseCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines                 PurchaseLine[]
  payments              PurchasePayment[]
  receipts              PurchaseReceipt[]
  lots                  InventoryLot[]
  movements             InventoryMovement[]
  documents             PurchaseDocument[]

  @@index([supplierId, purchaseDate])
  @@index([status, purchaseDate])
  @@index([branchCode, purchaseDate])
  @@index([createdById])
}

model PurchaseLine {
  id               String                @id @default(cuid())
  purchaseId       String
  itemId           String
  description      String
  unit             String
  orderedQuantity  Int
  receivedQuantity Int                   @default(0)
  unitCostCents    Int
  subtotalCents    Int
  createdAt        DateTime              @default(now())
  purchase         Purchase              @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  item             InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  receiptLines     PurchaseReceiptLine[]
  lots             InventoryLot[]
  movements        InventoryMovement[]

  @@index([purchaseId])
  @@index([itemId])
}

model PurchasePayment {
  id             String                @id @default(cuid())
  purchaseId     String
  cashSessionId  String?
  cashMovementId String?               @unique
  recordedById   String
  method         PurchasePaymentMethod
  amountCents    Int
  reference      String?
  idempotencyKey String                @unique
  paidAt         DateTime              @default(now())
  createdAt      DateTime              @default(now())
  purchase       Purchase              @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  cashSession    CashSession?          @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  cashMovement   CashMovement?         @relation(fields: [cashMovementId], references: [id], onDelete: Restrict)
  recordedBy     InternalUser          @relation("PurchasePaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([purchaseId, paidAt])
  @@index([cashSessionId])
  @@index([recordedById])
}

model PurchaseReceipt {
  id             String                @id @default(cuid())
  receiptNumber  String                @unique
  purchaseId     String
  recordedById   String
  receivedById   String
  branchCode     String
  locationCode   String
  documentNumber String?
  receivedAt     DateTime
  notes          String?
  idempotencyKey String                @unique
  createdAt      DateTime              @default(now())
  purchase       Purchase              @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  recordedBy     InternalUser          @relation("PurchaseReceiptRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  receivedBy     InternalUser          @relation("PurchaseReceiptReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  lines          PurchaseReceiptLine[]
  lots           InventoryLot[]
  movements      InventoryMovement[]
  documents      PurchaseDocument[]

  @@index([purchaseId, receivedAt])
  @@index([branchCode, locationCode, receivedAt])
  @@index([recordedById])
  @@index([receivedById])
}

model PurchaseReceiptLine {
  id             String             @id @default(cuid())
  receiptId      String
  purchaseLineId String
  itemId         String
  lotId          String             @unique
  quantity       Int
  unitCostCents  Int
  subtotalCents  Int
  createdAt      DateTime           @default(now())
  receipt        PurchaseReceipt    @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  purchaseLine   PurchaseLine       @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)
  item           InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot            InventoryLot       @relation(fields: [lotId], references: [id], onDelete: Restrict)
  inventoryEntry InventoryMovement?

  @@index([receiptId])
  @@index([purchaseLineId])
  @@index([itemId])
}

model InventoryLot {
  id               String                   @id @default(cuid())
  internalLotCode  String                   @unique
  itemId           String
  supplierId       String
  purchaseId       String
  purchaseLineId   String
  receiptId        String
  batchNumber      String?
  expirationDate   DateTime?                @db.Date
  branchCode       String
  locationCode     String
  receivedQuantity Int
  currentQuantity  Int
  unitCostCents    Int
  active           Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  item             InventoryItem            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  supplier         Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchase         Purchase                 @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  purchaseLine     PurchaseLine             @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)
  receipt          PurchaseReceipt          @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  receiptLine      PurchaseReceiptLine?
  movements        InventoryMovement[]
  adjustments      InventoryLotAdjustment[]

  @@index([itemId, branchCode, locationCode, expirationDate])
  @@index([supplierId])
  @@index([purchaseId])
  @@index([receiptId])
  @@index([batchNumber])
  @@index([active, expirationDate])
}

model InventoryLotAdjustment {
  id             String                     @id @default(cuid())
  itemId         String
  lotId          String
  recordedById   String
  authorizedById String
  kind           InventoryLotAdjustmentKind
  quantity       Int
  stockDelta     Int
  restocked      Boolean                    @default(false)
  reason         String
  idempotencyKey String                     @unique
  createdAt      DateTime                   @default(now())
  item           InventoryItem              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot            InventoryLot               @relation(fields: [lotId], references: [id], onDelete: Restrict)
  recordedBy     InternalUser               @relation("InventoryLotAdjustmentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  authorizedBy   InternalUser               @relation("InventoryLotAdjustmentAuthorizedBy", fields: [authorizedById], references: [id], onDelete: Restrict)
  movement       InventoryMovement?

  @@index([itemId, createdAt])
  @@index([lotId, createdAt])
  @@index([recordedById])
  @@index([authorizedById])
}

model PurchaseDocument {
  id             String                          @id @default(cuid())
  purchaseId     String
  receiptId      String?
  uploadedById   String
  kind           PurchaseDocumentKind
  storageKey     String                          @unique
  storageDriver  ClinicalAttachmentStorageDriver
  originalName   String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String
  createdAt      DateTime                        @default(now())
  purchase       Purchase                        @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  receipt        PurchaseReceipt?                @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  uploadedBy     InternalUser                    @relation("PurchaseDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([purchaseId, createdAt])
  @@index([receiptId])
  @@index([uploadedById])
}

model InventoryMovement {
  id              String                  @id @default(cuid())
  itemId          String
  saleId          String?
  saleItemId      String?
  purchaseId      String?
  purchaseLineId  String?
  receiptId       String?
  receiptLineId   String?                 @unique
  lotId           String?
  lotAdjustmentId String?                 @unique
  userId          String?
  type            InventoryMovementType
  quantityDelta   Int
  stockAfter      Int
  branchCode      String?
  locationCode    String?
  reason          String
  createdAt       DateTime                @default(now())
  item            InventoryItem           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  sale            Sale?                   @relation(fields: [saleId], references: [id], onDelete: SetNull)
  saleItem        SaleItem?               @relation(fields: [saleItemId], references: [id], onDelete: SetNull)
  purchase        Purchase?               @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  purchaseLine    PurchaseLine?           @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)
  receipt         PurchaseReceipt?        @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  receiptLine     PurchaseReceiptLine?    @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)
  lot             InventoryLot?           @relation(fields: [lotId], references: [id], onDelete: Restrict)
  lotAdjustment   InventoryLotAdjustment? @relation(fields: [lotAdjustmentId], references: [id], onDelete: Restrict)
  user            InternalUser?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([saleId])
  @@index([saleItemId])
  @@index([purchaseId])
  @@index([purchaseLineId])
  @@index([receiptId])
  @@index([lotId])
  @@index([userId])
  @@index([type, createdAt])
}

model InventoryAdjustment {
  id            String        @id @default(cuid())
  itemId        String
  userId        String?
  quantityDelta Int
  reason        String
  createdAt     DateTime      @default(now())
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  user          InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([userId])
  @@index([createdAt])
}

model InventoryAlert {
  id         String               @id @default(cuid())
  itemId     String
  status     InventoryAlertStatus @default(open)
  message    String
  createdAt  DateTime             @default(now())
  resolvedAt DateTime?
  item       InventoryItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([status, createdAt])
}
