generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InternalRole {
  super_admin
  direccion
  medico
  recepcion
  captacion
  administracion
  enfermeria
  seguimiento
}

enum InternalPermission {
  internal_access
  leads_read
  leads_create
  leads_update
  leads_contact
  leads_reminder
  patients_read
  patients_create
  patients_update
  visits_read
  visits_create
  visits_update
  patient_route_read
  patient_route_update
  clinical_read
  clinical_write
  nursing_read
  nursing_write
  studies_read
  studies_write
  sales_read
  sales_write
  payments_write
  followups_read
  followups_write
  inventory_read
  inventory_write
  inventory_adjust
  reports_read
  audit_read
}

enum AuditResult {
  success
  failure
  denied
}

enum InternalLeadSource {
  website
  whatsapp
  facebook
  facebook_ads
  facebook_organic
  tiktok
  google
  call
  referral
  previous_patient
  flyer
  other
}

enum InternalLeadStatus {
  new
  contacted
  interested
  wants_visit
  reminder_pending
  confirmed_attendance
  no_answer
  discarded
  converted_to_patient
}

enum InternalLeadContactMethod {
  call
  whatsapp
  in_person
  other
}

enum InternalLeadContactResult {
  contacted
  no_answer
  interested
  wants_visit
  confirmed_attendance
  discarded
  follow_up_required
}

enum InternalLeadReminderStatus {
  pending
  completed
  cancelled
}

enum PatientGender {
  female
  male
  other
  unknown
}

enum PatientStatus {
  active
  inactive
  archived
}

enum PatientCaptureSource {
  facebook
  facebook_ads
  facebook_organic
  tiktok
  whatsapp
  referral
  previous_patient
  flyer
  website
  other
}

enum FollowUpContactPreference {
  whatsapp
  call
  both
  no_contact
  unknown
}

enum VisitStatus {
  in_reception
  in_consultation
  in_nursing
  in_administration
  completed
  left_without_care
  cancelled
}

enum VisitIntakeType {
  first_visit
  treatment_control
  new_problem
  results_review
}

enum SymptomDurationUnit {
  days
  weeks
  months
  years
}

enum PatientRouteArea {
  recepcion
  medico
  enfermeria
  administracion
  seguimiento
  cierre
}

enum VisitWorkItemStatus {
  pending
  acknowledged
  in_progress
  completed
  cancelled
  blocked
}

enum DiagnosisKind {
  primary
  secondary
}

enum ClinicalOrderType {
  vital_signs
  study
  nursing_application
  serum
  medication
  administration
  follow_up
  other
}

enum ClinicalOrderStatus {
  pending
  acknowledged
  completed
  cancelled
  blocked
}

enum StudyType {
  laboratory
  ultrasound
  resonance
  imaging
  other
}

enum StudyStatus {
  requested
  performed
  reviewed
  cancelled
}

enum SaleStatus {
  pending
  partial
  paid
  cancelled
}

enum SaleItemType {
  treatment
  medication
  resonance
  serum
  service
  study
  product
  other
}

enum CashMovementType {
  income
  expense
  adjustment
}

enum FollowUpStatus {
  pending
  done
  improved
  not_improved
  no_answer
  wants_return
  requires_new_visit
  requires_doctor_call
  cancelled
}

enum FollowUpAttemptMethod {
  call
  whatsapp
  in_person
  other
}

enum InventoryMovementType {
  entry
  automatic_sale_exit
  authorized_manual_adjustment
  correction
}

enum InventoryAlertStatus {
  open
  resolved
}

model InternalUser {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  name                   String?
  passwordHash           String
  role                   InternalRole            @default(captacion)
  active                 Boolean                 @default(true)
  lastLoginAt            DateTime?
  failedAttempts         Int                     @default(0)
  lockedUntil            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  sessions               InternalSession[]
  assignedLeads          Lead[]                  @relation("LeadAssignee")
  contactAttempts        LeadContactAttempt[]
  reminders              LeadReminder[]
  statusChanges          LeadStatusHistory[]
  patientNotes           PatientNote[]
  createdVisits          Visit[]                 @relation("VisitCreatedBy")
  visitStatusChanges     VisitStatusHistory[]
  receptionCheckIns      ReceptionCheckIn[]
  createdWorkItems       VisitWorkItem[]
  clinicalConsultations  ClinicalConsultation[]
  prescriptions          Prescription[]
  clinicalEvolutions     ClinicalEvolution[]
  clinicalNotes          ClinicalNote[]
  clinicalOrders         ClinicalOrder[]
  recordedVitalSigns     VitalSigns[]
  nursingApplications    NursingApplication[]    @relation("NursingApplicationResponsible")
  nursingNotes           NursingNote[]
  requestedStudies       Study[]                 @relation("StudyRequestedBy")
  recordedStudies        Study[]                 @relation("StudyRecordedBy")
  nursingWorkItemResults NursingWorkItemResult[]
  createdSales           Sale[]                  @relation("SaleCreatedBy")
  receivedPayments       Payment[]
  cashMovements          CashMovement[]
  assignedFollowUps      FollowUpTask[]          @relation("FollowUpAssignedTo")
  createdFollowUps       FollowUpTask[]          @relation("FollowUpCreatedBy")
  followUpAttempts       FollowUpAttempt[]
  followUpStatusChanges  FollowUpStatusHistory[]
  inventoryMovements     InventoryMovement[]
  inventoryAdjustments   InventoryAdjustment[]
  auditEvents            AuditEvent[]

  @@index([role])
  @@index([active])
}

model InternalSession {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime     @default(now())
  user      InternalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Historial técnico inmutable de acciones críticas dentro de SIGECO.
/// La aplicación solo puede insertar y consultar. Una protección adicional
/// en PostgreSQL rechaza UPDATE y DELETE incluso si se intentan con SQL directo.
model AuditEvent {
  id         String        @id @default(cuid())
  actorId    String?
  actorRole  InternalRole?
  action     String
  entityType String
  entityId   String?
  result     AuditResult
  requestId  String
  context    Json?
  occurredAt DateTime      @default(now())
  actor      InternalUser? @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@index([entityType, occurredAt])
  @@index([result, occurredAt])
}

model Lead {
  id                 String               @id @default(cuid())
  name               String?
  phone              String
  email              String?
  city               String?
  symptoms           String?
  intentionToVisit   String?
  estimatedVisitDate DateTime?
  commercialNotes    String?
  source             InternalLeadSource   @default(website)
  status             InternalLeadStatus   @default(new)
  pagePath           String?
  assignedToId       String?
  convertedPatientId String?
  firstContactedAt   DateTime?
  lastContactedAt    DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  assignedTo         InternalUser?        @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedPatient   Patient?             @relation("LeadConvertedPatient", fields: [convertedPatientId], references: [id], onDelete: SetNull)
  contactAttempts    LeadContactAttempt[]
  reminders          LeadReminder[]
  statusHistory      LeadStatusHistory[]
  followUpTasks      FollowUpTask[]

  @@index([createdAt])
  @@index([phone])
  @@index([status, createdAt])
  @@index([source])
  @@index([assignedToId])
  @@index([convertedPatientId])
}

model LeadContactAttempt {
  id          String                    @id @default(cuid())
  leadId      String
  userId      String?
  method      InternalLeadContactMethod @default(call)
  result      InternalLeadContactResult
  notes       String?
  contactedAt DateTime                  @default(now())
  createdAt   DateTime                  @default(now())
  lead        Lead                      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        InternalUser?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([contactedAt])
}

model LeadReminder {
  id          String                     @id @default(cuid())
  leadId      String
  userId      String?
  dueAt       DateTime
  note        String?
  status      InternalLeadReminderStatus @default(pending)
  completedAt DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  lead        Lead                       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        InternalUser?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([status, dueAt])
}

model LeadStatusHistory {
  id         String              @id @default(cuid())
  leadId     String
  userId     String?
  fromStatus InternalLeadStatus?
  toStatus   InternalLeadStatus
  note       String?
  createdAt  DateTime            @default(now())
  lead       Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user       InternalUser?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
}

model Patient {
  id                    String                    @id @default(cuid())
  internalCode          String                    @unique
  fullName              String
  phone                 String
  secondaryPhone        String?
  birthDate             DateTime?
  gender                PatientGender             @default(unknown)
  city                  String?
  department            String?
  address               String?
  captureSource         PatientCaptureSource      @default(other)
  captureSources        PatientCaptureSource[]    @default([])
  firstVisitAt          DateTime?
  generalObservations   String?
  allergies             String?
  relevantHistory       String?
  currentMedication     String?
  followUpPreference    FollowUpContactPreference @default(unknown)
  status                PatientStatus             @default(active)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  convertedLeads        Lead[]                    @relation("LeadConvertedPatient")
  contacts              PatientContact[]
  notes                 PatientNote[]
  visits                Visit[]
  clinicalConsultations ClinicalConsultation[]
  prescriptions         Prescription[]
  clinicalEvolutions    ClinicalEvolution[]
  clinicalNotes         ClinicalNote[]
  clinicalOrders        ClinicalOrder[]
  vitalSigns            VitalSigns[]
  nursingApplications   NursingApplication[]
  nursingNotes          NursingNote[]
  studies               Study[]
  sales                 Sale[]
  payments              Payment[]
  deliveredProducts     DeliveredProduct[]
  cashMovements         CashMovement[]
  followUpTasks         FollowUpTask[]

  @@index([fullName])
  @@index([phone])
  @@index([status])
  @@index([captureSource])
  @@index([createdAt])
}

model PatientContact {
  id        String   @id @default(cuid())
  patientId String
  label     String?
  phone     String
  createdAt DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([phone])
}

model PatientNote {
  id        String        @id @default(cuid())
  patientId String
  userId    String?
  note      String
  createdAt DateTime      @default(now())
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user      InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([userId])
  @@index([createdAt])
}

model Visit {
  id                   String                @id @default(cuid())
  patientId            String
  status               VisitStatus           @default(in_reception)
  reason               String?
  intakeType           VisitIntakeType       @default(first_visit)
  symptomDurationValue Int?
  symptomDurationUnit  SymptomDurationUnit?
  previouslyTreated    Boolean?
  bringsStudies        Boolean               @default(false)
  createdById          String?
  checkedInAt          DateTime              @default(now())
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  patient              Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdBy            InternalUser?         @relation("VisitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  checkIn              ReceptionCheckIn?
  route                PatientRoute?
  statusHistory        VisitStatusHistory[]
  workItems            VisitWorkItem[]
  clinicalConsultation ClinicalConsultation?
  prescriptions        Prescription[]
  clinicalEvolutions   ClinicalEvolution[]
  clinicalNotes        ClinicalNote[]
  clinicalOrders       ClinicalOrder[]
  vitalSigns           VitalSigns[]
  nursingApplications  NursingApplication[]
  nursingNotes         NursingNote[]
  studies              Study[]
  sales                Sale[]
  payments             Payment[]
  deliveredProducts    DeliveredProduct[]
  cashMovements        CashMovement[]
  followUpTasks        FollowUpTask[]

  @@index([patientId])
  @@index([status, checkedInAt])
  @@index([createdById])
  @@index([checkedInAt])
}

model VisitStatusHistory {
  id         String        @id @default(cuid())
  visitId    String
  userId     String?
  fromStatus VisitStatus?
  toStatus   VisitStatus
  note       String?
  createdAt  DateTime      @default(now())
  visit      Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  user       InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([visitId])
  @@index([userId])
  @@index([createdAt])
}

model ClinicalConsultation {
  id                String          @id @default(cuid())
  visitId           String          @unique
  patientId         String
  doctorId          String?
  motive            String
  findings          String?
  observations      String?
  treatmentPlanText String?
  indications       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  visit             Visit           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient           Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor            InternalUser?   @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  diagnoses         Diagnosis[]
  treatmentPlans    TreatmentPlan[]

  @@index([patientId])
  @@index([doctorId])
  @@index([createdAt])
}

model Diagnosis {
  id             String               @id @default(cuid())
  consultationId String
  kind           DiagnosisKind        @default(secondary)
  name           String
  findings       String?
  observations   String?
  createdAt      DateTime             @default(now())
  consultation   ClinicalConsultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@index([kind])
}

model TreatmentPlan {
  id             String               @id @default(cuid())
  consultationId String
  internalName   String?
  medications    String?
  dosage         String?
  duration       String?
  observations   String?
  createdAt      DateTime             @default(now())
  consultation   ClinicalConsultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
}

model Prescription {
  id        String             @id @default(cuid())
  visitId   String
  patientId String
  doctorId  String?
  notes     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  visit     Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient   Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor    InternalUser?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  items     PrescriptionItem[]

  @@index([visitId])
  @@index([patientId])
  @@index([doctorId])
  @@index([createdAt])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  medication     String
  dose           String?
  frequency      String?
  duration       String?
  observations   String?
  createdAt      DateTime     @default(now())
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

model ClinicalEvolution {
  id        String        @id @default(cuid())
  visitId   String
  patientId String
  userId    String?
  note      String
  createdAt DateTime      @default(now())
  visit     Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  user      InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([visitId])
  @@index([patientId])
  @@index([userId])
  @@index([createdAt])
}

model ClinicalNote {
  id        String        @id @default(cuid())
  visitId   String
  patientId String
  userId    String?
  note      String
  createdAt DateTime      @default(now())
  visit     Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  user      InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([visitId])
  @@index([patientId])
  @@index([userId])
  @@index([createdAt])
}

model ClinicalOrder {
  id                     String                  @id @default(cuid())
  visitId                String
  patientId              String
  doctorId               String?
  workItemId             String?
  type                   ClinicalOrderType
  targetArea             PatientRouteArea
  status                 ClinicalOrderStatus     @default(pending)
  title                  String
  details                String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  visit                  Visit                   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient                Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor                 InternalUser?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  workItem               VisitWorkItem?          @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  nursingApplications    NursingApplication[]
  studies                Study[]
  nursingWorkItemResults NursingWorkItemResult[]
  followUpTasks          FollowUpTask[]

  @@index([visitId])
  @@index([patientId])
  @@index([doctorId])
  @@index([targetArea, status])
  @@index([createdAt])
}

model ReceptionCheckIn {
  id        String        @id @default(cuid())
  visitId   String        @unique
  userId    String?
  note      String?
  createdAt DateTime      @default(now())
  visit     Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  user      InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model PatientRoute {
  id          String             @id @default(cuid())
  visitId     String             @unique
  currentArea PatientRouteArea   @default(recepcion)
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  visit       Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  steps       PatientRouteStep[]

  @@index([currentArea])
  @@index([active])
}

model PatientRouteStep {
  id        String           @id @default(cuid())
  routeId   String
  area      PatientRouteArea
  status    VisitStatus
  note      String?
  startedAt DateTime         @default(now())
  endedAt   DateTime?
  route     PatientRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId])
  @@index([area])
  @@index([startedAt])
}

model VisitWorkItem {
  id                     String                  @id @default(cuid())
  visitId                String
  createdById            String?
  area                   PatientRouteArea
  status                 VisitWorkItemStatus     @default(pending)
  title                  String
  description            String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  completedAt            DateTime?
  visit                  Visit                   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  createdBy              InternalUser?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  clinicalOrders         ClinicalOrder[]
  nursingApplications    NursingApplication[]
  studies                Study[]
  nursingWorkItemResults NursingWorkItemResult[]
  sales                  Sale[]
  followUpTasks          FollowUpTask[]

  @@index([visitId])
  @@index([createdById])
  @@index([area, status])
  @@index([createdAt])
}

model Study {
  id              String            @id @default(cuid())
  patientId       String
  visitId         String?
  clinicalOrderId String?
  workItemId      String?
  requestedById   String?
  recordedById    String?
  type            StudyType         @default(other)
  status          StudyStatus       @default(performed)
  title           String
  resultSummary   String?
  findings        String?
  performedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit           Visit?            @relation(fields: [visitId], references: [id], onDelete: SetNull)
  clinicalOrder   ClinicalOrder?    @relation(fields: [clinicalOrderId], references: [id], onDelete: SetNull)
  workItem        VisitWorkItem?    @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  requestedBy     InternalUser?     @relation("StudyRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  recordedBy      InternalUser?     @relation("StudyRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  attachments     StudyAttachment[]

  @@index([patientId])
  @@index([visitId])
  @@index([clinicalOrderId])
  @@index([workItemId])
  @@index([type, status])
  @@index([performedAt])
  @@index([createdAt])
}

model StudyAttachment {
  id          String   @id @default(cuid())
  studyId     String
  fileName    String
  contentType String?
  storageKey  String?
  url         String?
  notes       String?
  createdAt   DateTime @default(now())
  study       Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId])
}

model VitalSigns {
  id                    String        @id @default(cuid())
  patientId             String
  visitId               String?
  recordedById          String?
  temperatureCelsius    Decimal?      @db.Decimal(4, 1)
  systolicPressureMmHg  Int?
  diastolicPressureMmHg Int?
  heartRateBpm          Int?
  respiratoryRateRpm    Int?
  oxygenSaturation      Int?
  weightKg              Decimal?      @db.Decimal(5, 2)
  heightCm              Decimal?      @db.Decimal(5, 2)
  notes                 String?
  recordedAt            DateTime      @default(now())
  createdAt             DateTime      @default(now())
  patient               Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit                 Visit?        @relation(fields: [visitId], references: [id], onDelete: SetNull)
  recordedBy            InternalUser? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([visitId])
  @@index([recordedById])
  @@index([recordedAt])
}

model NursingApplication {
  id              String         @id @default(cuid())
  patientId       String
  visitId         String?
  clinicalOrderId String?
  workItemId      String?
  responsibleId   String?
  medication      String
  quantity        String?
  route           String?
  appliedAt       DateTime       @default(now())
  notes           String?
  createdAt       DateTime       @default(now())
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit           Visit?         @relation(fields: [visitId], references: [id], onDelete: SetNull)
  clinicalOrder   ClinicalOrder? @relation(fields: [clinicalOrderId], references: [id], onDelete: SetNull)
  workItem        VisitWorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  responsible     InternalUser?  @relation("NursingApplicationResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([visitId])
  @@index([clinicalOrderId])
  @@index([workItemId])
  @@index([responsibleId])
  @@index([appliedAt])
}

model NursingNote {
  id        String        @id @default(cuid())
  patientId String
  visitId   String?
  userId    String?
  note      String
  createdAt DateTime      @default(now())
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit     Visit?        @relation(fields: [visitId], references: [id], onDelete: SetNull)
  user      InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([visitId])
  @@index([userId])
  @@index([createdAt])
}

model ClinicalAttachment {
  id          String   @id @default(cuid())
  patientId   String
  visitId     String?
  label       String
  contentType String?
  storageKey  String?
  url         String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([patientId])
  @@index([visitId])
  @@index([createdAt])
}

model NursingWorkItemResult {
  id              String              @id @default(cuid())
  workItemId      String
  clinicalOrderId String?
  userId          String?
  status          VisitWorkItemStatus
  outcome         String?
  notes           String?
  createdAt       DateTime            @default(now())
  workItem        VisitWorkItem       @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  clinicalOrder   ClinicalOrder?      @relation(fields: [clinicalOrderId], references: [id], onDelete: SetNull)
  user            InternalUser?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workItemId])
  @@index([clinicalOrderId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Sale {
  id                 String              @id @default(cuid())
  patientId          String
  visitId            String?
  workItemId         String?
  createdById        String?
  status             SaleStatus          @default(pending)
  subtotalCents      Int                 @default(0)
  discountCents      Int                 @default(0)
  totalCents         Int                 @default(0)
  paidCents          Int                 @default(0)
  balanceCents       Int                 @default(0)
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  patient            Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit              Visit?              @relation(fields: [visitId], references: [id], onDelete: SetNull)
  workItem           VisitWorkItem?      @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  createdBy          InternalUser?       @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items              SaleItem[]
  payments           Payment[]
  deliveredProducts  DeliveredProduct[]
  cashMovements      CashMovement[]
  followUpTasks      FollowUpTask[]
  inventoryMovements InventoryMovement[]

  @@index([patientId])
  @@index([visitId])
  @@index([workItemId])
  @@index([createdById])
  @@index([status, createdAt])
  @@index([createdAt])
}

model SaleItem {
  id                 String              @id @default(cuid())
  saleId             String
  inventoryItemId    String?
  type               SaleItemType        @default(other)
  description        String
  quantity           Int                 @default(1)
  unitPriceCents     Int
  totalCents         Int
  delivered          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  sale               Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  inventoryItem      InventoryItem?      @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  deliveredProducts  DeliveredProduct[]
  inventoryMovements InventoryMovement[]

  @@index([saleId])
  @@index([inventoryItemId])
  @@index([type])
}

model PaymentMethod {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  payments  Payment[]
}

model Payment {
  id            String         @id @default(cuid())
  saleId        String
  patientId     String
  visitId       String?
  methodId      String
  receivedById  String?
  amountCents   Int
  reference     String?
  notes         String?
  paidAt        DateTime       @default(now())
  createdAt     DateTime       @default(now())
  sale          Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit         Visit?         @relation(fields: [visitId], references: [id], onDelete: SetNull)
  method        PaymentMethod  @relation(fields: [methodId], references: [id], onDelete: Restrict)
  receivedBy    InternalUser?  @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  cashMovements CashMovement[]

  @@index([saleId])
  @@index([patientId])
  @@index([visitId])
  @@index([methodId])
  @@index([receivedById])
  @@index([paidAt])
}

model DeliveredProduct {
  id          String    @id @default(cuid())
  saleId      String
  saleItemId  String?
  patientId   String
  visitId     String?
  description String
  quantity    Int       @default(1)
  deliveredAt DateTime  @default(now())
  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleItem    SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: SetNull)
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit       Visit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([saleItemId])
  @@index([patientId])
  @@index([visitId])
  @@index([deliveredAt])
}

model CashMovement {
  id          String           @id @default(cuid())
  saleId      String?
  paymentId   String?
  patientId   String?
  visitId     String?
  userId      String?
  type        CashMovementType @default(income)
  amountCents Int
  description String
  occurredAt  DateTime         @default(now())
  createdAt   DateTime         @default(now())
  sale        Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  payment     Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  patient     Patient?         @relation(fields: [patientId], references: [id], onDelete: SetNull)
  visit       Visit?           @relation(fields: [visitId], references: [id], onDelete: SetNull)
  user        InternalUser?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([paymentId])
  @@index([patientId])
  @@index([visitId])
  @@index([userId])
  @@index([type, occurredAt])
}

model FollowUpTask {
  id              String                  @id @default(cuid())
  leadId          String?
  patientId       String?
  visitId         String?
  saleId          String?
  clinicalOrderId String?
  workItemId      String?
  assignedToId    String?
  createdById     String?
  status          FollowUpStatus          @default(pending)
  title           String
  notes           String?
  dueAt           DateTime
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  lead            Lead?                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  patient         Patient?                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visit           Visit?                  @relation(fields: [visitId], references: [id], onDelete: SetNull)
  sale            Sale?                   @relation(fields: [saleId], references: [id], onDelete: SetNull)
  clinicalOrder   ClinicalOrder?          @relation(fields: [clinicalOrderId], references: [id], onDelete: SetNull)
  workItem        VisitWorkItem?          @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  assignedTo      InternalUser?           @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy       InternalUser?           @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  attempts        FollowUpAttempt[]
  statusHistory   FollowUpStatusHistory[]

  @@index([leadId])
  @@index([patientId])
  @@index([visitId])
  @@index([saleId])
  @@index([clinicalOrderId])
  @@index([workItemId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status, dueAt])
  @@index([createdAt])
}

model FollowUpAttempt {
  id          String                @id @default(cuid())
  taskId      String
  userId      String?
  method      FollowUpAttemptMethod @default(call)
  result      FollowUpStatus
  notes       String?
  contactedAt DateTime              @default(now())
  createdAt   DateTime              @default(now())
  task        FollowUpTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        InternalUser?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([userId])
  @@index([result])
  @@index([contactedAt])
}

model FollowUpStatusHistory {
  id         String          @id @default(cuid())
  taskId     String
  userId     String?
  fromStatus FollowUpStatus?
  toStatus   FollowUpStatus
  note       String?
  createdAt  DateTime        @default(now())
  task       FollowUpTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       InternalUser?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
}

model FollowUpTemplate {
  id        String   @id @default(cuid())
  title     String
  body      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active])
}

model Supplier {
  id        String          @id @default(cuid())
  name      String
  phone     String?
  notes     String?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  items     InventoryItem[]

  @@index([name])
  @@index([active])
}

model InventoryItem {
  id           String                @id @default(cuid())
  supplierId   String?
  sku          String?               @unique
  internalCode String                @unique
  name         String
  description  String?
  unit         String                @default("unidad")
  currentStock Int                   @default(0)
  minimumStock Int                   @default(0)
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  supplier     Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  saleItems    SaleItem[]
  movements    InventoryMovement[]
  adjustments  InventoryAdjustment[]
  alerts       InventoryAlert[]

  @@index([supplierId])
  @@index([name])
  @@index([active])
  @@index([currentStock])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  itemId        String
  saleId        String?
  saleItemId    String?
  userId        String?
  type          InventoryMovementType
  quantityDelta Int
  stockAfter    Int
  reason        String
  createdAt     DateTime              @default(now())
  item          InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  sale          Sale?                 @relation(fields: [saleId], references: [id], onDelete: SetNull)
  saleItem      SaleItem?             @relation(fields: [saleItemId], references: [id], onDelete: SetNull)
  user          InternalUser?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([saleId])
  @@index([saleItemId])
  @@index([userId])
  @@index([type, createdAt])
}

model InventoryAdjustment {
  id            String        @id @default(cuid())
  itemId        String
  userId        String?
  quantityDelta Int
  reason        String
  createdAt     DateTime      @default(now())
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  user          InternalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([userId])
  @@index([createdAt])
}

model InventoryAlert {
  id         String               @id @default(cuid())
  itemId     String
  status     InventoryAlertStatus @default(open)
  message    String
  createdAt  DateTime             @default(now())
  resolvedAt DateTime?
  item       InventoryItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([status, createdAt])
}
