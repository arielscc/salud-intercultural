{
  "name": "salud-intercultural-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm env:check && prisma generate && payload generate:types && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "prisma generate && vitest run --exclude \"**/*.integration.test.{ts,tsx}\"",
    "test:unit": "prisma generate && vitest run --exclude \"**/*.integration.test.{ts,tsx}\"",
    "test:watch": "prisma generate && vitest --exclude \"**/*.integration.test.{ts,tsx}\"",
    "test:integration": "prisma generate && pnpm test:db:reset && DOTENV_CONFIG_PATH=.env.test node --import dotenv/config ./node_modules/vitest/vitest.mjs run integration.test --pool=forks --no-file-parallelism",
    "test:db:reset": "DOTENV_CONFIG_PATH=.env.test node --import dotenv/config --import tsx scripts/reset-test-database.ts",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "audit:high": "pnpm audit --audit-level high --ignore GHSA-mh99-v99m-4gvg",
    "deps:check": "pnpm peers check && pnpm audit:prod && pnpm audit:high",
    "typecheck": "prisma generate && payload generate:types && next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "node --import dotenv/config --import tsx scripts/reset-database.ts",
    "env:check": "node --import tsx scripts/validate-environment.ts",
    "seed": "pnpm payload:seed",
    "seed:demo": "node --import dotenv/config --import tsx scripts/seed-demo-catalog.ts",
    "seed:demo-consultas": "node --import dotenv/config --import tsx scripts/seed-demo-consultations.ts",
    "seed:indications": "node --import dotenv/config --import tsx scripts/seed-indication-catalog.ts",
    "seed:diagnoses": "node --import dotenv/config --import tsx scripts/seed-diagnosis-catalog.ts",
    "seed:diagnosis-templates": "node --import dotenv/config --import tsx scripts/seed-diagnosis-templates.ts",
    "seed:clinical-notes": "node --import dotenv/config --import tsx scripts/seed-clinical-note-catalog.ts",
    "db:studio": "prisma studio",
    "payload": "payload",
    "payload:seed": "node --import tsx scripts/seed-payload.ts",
    "payload:seed:staging": "DOTENV_CONFIG_PATH=.env.staging pnpm payload:seed",
    "staging:check": "DOTENV_CONFIG_PATH=.env.staging node --import dotenv/config --import tsx scripts/validate-environment.ts --expect staging",
    "staging:sync-vercel": "node --import tsx scripts/sync-vercel-staging-env.ts",
    "staging:migrate": "pnpm staging:check && DOTENV_CONFIG_PATH=.env.staging pnpm exec prisma migrate deploy",
    "staging:seed:sigeco": "DOTENV_CONFIG_PATH=.env.staging node --import dotenv/config --import tsx scripts/seed-staging-sigeco.ts",
    "staging:seed": "pnpm staging:check && pnpm payload:seed:staging && pnpm staging:seed:sigeco",
    "staging:seed:demo": "pnpm staging:check && DOTENV_CONFIG_PATH=.env.staging node --import dotenv/config --import tsx scripts/seed-demo-catalog.ts",
    "staging:verify": "DOTENV_CONFIG_PATH=.env.staging node --import dotenv/config --import tsx scripts/verify-staging.ts",
    "staging:modules": "DOTENV_CONFIG_PATH=.env.staging node --import dotenv/config --import tsx scripts/set-module-activation.ts",
    "staging:stage-one:check": "DOTENV_CONFIG_PATH=.env.staging node --import dotenv/config --import tsx scripts/check-stage-one-readiness.ts",
    "staging:rehearse": "pnpm staging:check && DOTENV_CONFIG_PATH=.env.staging node --import dotenv/config --import tsx scripts/rehearse-stage-one.ts",
    "staging:reset": "DOTENV_CONFIG_PATH=.env.staging node --import dotenv/config --import tsx scripts/reset-staging.ts",
    "backup:create:local": "node --import tsx scripts/backup/create-local-backup.ts",
    "backup:restore:local": "node --import tsx scripts/backup/restore-local-backup.ts",
    "backup:drill:local": "node --import tsx scripts/backup/drill-local-backup.ts",
    "security:incident:drill:local": "node --import tsx scripts/security/incident-drill-local.ts",
    "security:gate:local": "node --import tsx scripts/security/security-gate.ts",
    "payload:generate-types": "payload generate:types",
    "internal:seed": "node --import dotenv/config --import tsx scripts/seed-internal-user.ts",
    "branches:seed:synthetic": "node --import dotenv/config --import tsx scripts/seed-multi-branch-synthetic.ts",
    "internal:set-role": "node --import dotenv/config --import tsx scripts/set-internal-user-role.ts",
    "modules:set": "node --import dotenv/config --import tsx scripts/set-module-activation.ts",
    "promote:staging": "node --import tsx scripts/promote-branch.ts staging",
    "promote:main": "node --import tsx scripts/promote-branch.ts main",
    "ci": "gh run list --branch develop --limit 5",
    "ci:watch": "gh run watch",
    "ci:failed": "gh run view --log-failed",
    "stage-one:check": "node --import dotenv/config --import tsx scripts/check-stage-one-readiness.ts",
    "stage-one:load": "node --import dotenv/config --import tsx scripts/load-stage-one-master-data.ts",
    "stage-one:rehearse": "node --import dotenv/config --import tsx scripts/rehearse-stage-one.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "^3.10.0",
    "@next/env": "16.2.12",
    "@payloadcms/db-postgres": "^3.86.0",
    "@payloadcms/next": "^3.86.0",
    "@payloadcms/richtext-lexical": "^3.86.0",
    "@payloadcms/storage-vercel-blob": "^3.86.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@vercel/blob": "2.3.1",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-es-es": "^4.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.1.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "next": "^16.2.12",
    "payload": "^3.86.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.75.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.0",
    "esbuild": "0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "prisma": "^7.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.0.16",
    "vitest": "^4.1.10"
  }
}
