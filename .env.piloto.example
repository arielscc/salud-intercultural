# Entorno local del PILOTO DE COCHABAMBA.
#
# Es una segunda base en el mismo PostgreSQL de Docker. No comparte nada con
# `.env` (El Alto, salud_intercultural_dev): ni datos, ni módulos encendidos,
# ni archivos clínicos. Se puede borrar entera sin tocar el entorno de trabajo.
#
# Se usa siempre con `pnpm piloto:<comando>` o con DOTENV_CONFIG_PATH=.env.piloto.
#
# El host es 127.0.0.1 y no localhost a propósito: la cookie de sesión no lleva
# puerto, así que dos entornos en `localhost` se pisarían la sesión entre sí.

# Public app configuration
NEXT_PUBLIC_APP_ENV="local"
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3001"
NEXT_PUBLIC_SITE_NAME="Salud Intercultural"

# Public analytics and verification
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
GOOGLE_SITE_VERIFICATION=""

# Public contact channels
NEXT_PUBLIC_WHATSAPP_NUMBER="+59164175822"
NEXT_PUBLIC_CALL_PHONE="+59164175822"
NEXT_PUBLIC_CONTACT_EMAIL="medicina.tradicional.ea@gmail.com"
NEXT_PUBLIC_GOOGLE_MAPS_URL=""

# Private database
APP_ENV="local"
DATABASE_ENVIRONMENT="local"
DATABASE_URL="postgresql://salud_intercultural:salud_intercultural@localhost:5432/salud_intercultural_piloto?schema=public"

# Private Payload CMS
PAYLOAD_SECRET="local-development-secret-change-me"
PAYLOAD_PUBLIC_SERVER_URL="http://127.0.0.1:3001"
PAYLOAD_DB_SCHEMA="payload"

# Private media storage
STORAGE_ENVIRONMENT="local"
BLOB_READ_WRITE_TOKEN=""

# Los adjuntos clínicos van a su propia carpeta: el piloto no lee ni escribe
# los archivos del entorno de El Alto.
CLINICAL_FILES_STORAGE_DRIVER="local"
CLINICAL_FILES_LOCAL_PATH=".data/clinical-files-piloto"

# Nunca se abren canales reales desde un entorno de prueba.
EXTERNAL_COMMUNICATIONS_MODE="blocked"

# Private admin seed/session configuration
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_RESET_PASSWORD_ON_SEED="false"
ADMIN_SESSION_SECONDS="28800"
ADMIN_LOCK_MINUTES="10"

# Carpeta de compilacion propia: el candado del servidor de desarrollo vive
# dentro y dos entornos no pueden compartirlo.
NEXT_DIST_DIR=".next-piloto"

# Private security and build behavior
RATE_LIMIT_MAX="10"
RATE_LIMIT_WINDOW_SECONDS="60"
CMS_READS_DURING_BUILD="false"

# Cuenta interna del piloto. La contraseña no se inventa: se copia de la que ya
# se usa en local o la entrega quien administra las cuentas.
# `INTERNAL_ADMIN_BRANCH` decide la sucursal predeterminada; sin ella queda El Alto.
INTERNAL_ADMIN_EMAIL="correo-de-la-cuenta-interna"
INTERNAL_ADMIN_PASSWORD="contraseña-de-al-menos-10-caracteres"
INTERNAL_ADMIN_BRANCH=cochabamba
