# Public app configuration
# Local: http://localhost:3000
# Vercel production without custom domain: https://salud-intercultural.vercel.app
# Production custom domain: https://saludintercultural.com
NEXT_PUBLIC_APP_ENV="local"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Salud Intercultural"

# Public analytics and verification
# Optional until analytics/Search Console are enabled.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
GOOGLE_SITE_VERIFICATION=""

# Public contact channels
# Both numbers can receive WhatsApp and calls. Primary: +59164175822.
NEXT_PUBLIC_WHATSAPP_NUMBER="+59164175822"
NEXT_PUBLIC_CALL_PHONE="+59164175822"
NEXT_PUBLIC_CONTACT_EMAIL="medicina.tradicional.ea@gmail.com"
NEXT_PUBLIC_GOOGLE_MAPS_URL=""

# Private database
# Production recommendation: Neon or Vercel Postgres.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
APP_ENV="local"
DATABASE_ENVIRONMENT="local"
DATABASE_URL=""

# Private Payload CMS
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=""
PAYLOAD_PUBLIC_SERVER_URL="http://localhost:3000"
PAYLOAD_DB_SCHEMA="payload"

# Private media storage
# Production recommendation: Vercel Blob connected to the Vercel project.
# Vercel usually injects this after adding Blob Storage.
STORAGE_ENVIRONMENT="local"
BLOB_READ_WRITE_TOKEN=""
# Staging uses a separate store created with the STAGING_BLOB prefix.
STAGING_BLOB_READ_WRITE_TOKEN=""

# Private clinical attachments. Never reuse the public Payload media store.
CLINICAL_FILES_STORAGE_DRIVER="local"
CLINICAL_FILES_LOCAL_PATH=".data/clinical-files"
CLINICAL_BLOB_READ_WRITE_TOKEN=""
STAGING_CLINICAL_BLOB_READ_WRITE_TOKEN=""

# Outbound communication safety
# Only production may use "enabled". Local, test and staging stay blocked.
EXTERNAL_COMMUNICATIONS_MODE="blocked"

# Private admin seed/session configuration
# ADMIN_EMAIL and ADMIN_PASSWORD are used by the seed script to create the first admin.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_RESET_PASSWORD_ON_SEED="false"
ADMIN_SESSION_SECONDS="28800"
ADMIN_LOCK_MINUTES="10"

# Private Sigeco internal auth seed/session configuration
# INTERNAL_ADMIN_EMAIL and INTERNAL_ADMIN_PASSWORD are used by pnpm internal:seed
# to create the first Sigeco super administrator.
INTERNAL_SESSION_SECONDS="28800"
INTERNAL_LOCK_MINUTES="10"
INTERNAL_ADMIN_EMAIL=""
INTERNAL_ADMIN_PASSWORD=""

# Staging-only synthetic QA accounts
STAGING_QA_EMAIL_DOMAIN=""
STAGING_QA_PASSWORD=""

# Private security and build behavior
RATE_LIMIT_MAX="10"
RATE_LIMIT_WINDOW_SECONDS="60"
CMS_READS_DURING_BUILD="false"
